# Lists, maps, for-in, and the container builtins.
let words = split("the cat sat on the mat the end", " ");

let counts = {};
for w in words {
  if has(counts, w) {
    counts[w] = counts[w] + 1;
  } else {
    counts[w] = 1;
  }
}

# Map iteration visits keys in sorted order, so this is deterministic.
for k in counts {
  print(k, counts[k]);
}
