# ting testing ting: the sharp edges, pinned on both engines.

# Unicode: chars, not bytes — including astral-plane characters.
let s = "a🎈é";
assert(len(s) == 3, "astral chars count as one");
assert(s[1] == "🎈", "index by char");
assert(slice(s, 1, 2) == "🎈", "slice by char");
assert(slice("ab", -99, 99) == "ab", "slice clamps hard");

# Integer division truncates toward zero; remainder keeps the sign
# of the dividend.
assert(-7 / 2 == -3, "division truncates toward zero");
assert(-7 % 2 == -1, "remainder keeps dividend sign");
assert(7 % -2 == 1, "remainder keeps dividend sign (positive)");
assert(int(3.99) == 3 && int(-3.99) == -3, "int() truncates toward zero");

# Float rendering: integral floats keep a decimal, IEEE warts intact.
assert(str(1.0) == "1.0", "integral float renders with .0");
assert(str(0.1 + 0.2) == "0.30000000000000004", "IEEE 754 is honest");

# Structural equality crosses int/float element-wise.
assert([1, [2]] == [1.0, [2.0]], "deep numeric equality");
assert({"b": 1, "a": 2} == {"a": 2, "b": 1}, "map order is irrelevant");

# Three closures deep, capture still shared.
fn outer() {
  let x = 1;
  return fn() {
    let y = 2;
    return fn() { return x + y; };
  };
}
assert(outer()()() == 3, "nested closure capture");

# Chained everything.
assert([[fn() { return 7; }]][0][0]() == 7, "index-index-call chain");

# Negative-index writes.
let xs = [1, 2, 3];
xs[-1] = 9;
assert(xs == [1, 2, 9], "negative index write");

# Empty containers iterate zero times.
let hits = 0;
for x in [] { hits = hits + 1; }
for k in {} { hits = hits + 1; }
for c in "" { hits = hits + 1; }
assert(hits == 0, "empty iterations");

# Shadowing a builtin is scoped.
{
  let len = 5;
  assert(len == 5, "builtin shadowed in scope");
}
assert(len("abc") == 3, "builtin restored after scope");

# try inside try; errors carry through cleanly.
let inner = try(fn() { return try(fn() { fail("deep"); }); });
assert(inner["ok"]["err"] == "deep", "nested try");

# format brace escapes compose.
assert(format("{{}}") == "{}", "escaped braces only");
assert(format("{{{}}}", 1) == "{1}", "escape around placeholder");

# range with a step, both directions; zero step is an error.
assert(range(0, 10, 3) == [0, 3, 6, 9], "range positive step");
assert(range(5, 0, -1) == [5, 4, 3, 2, 1], "range negative step");
assert(range(0, 5, -1) == [], "range wrong-way step is empty");
assert(range(3, 3, 2) == [], "range empty span with step");
assert(has(try(range, 0, 5, 0), "err"), "range zero step fails");

# find: first index or nil; char (not byte) indexing on strings.
assert(find("hello", "llo") == 2, "find substring");
assert(find("hello", "zz") == nil, "find miss is nil");
assert(find("héllo", "llo") == 2, "find counts chars not bytes");
assert(find([10, 20, 30], 20) == 1, "find in list");
assert(find([1, 2], 9) == nil, "find list miss");
assert(find([1, [2]], [2]) == 1, "find structural equality");

# A map literal with the same key twice: the last one wins, and the
# map holds one entry. --check warns about the literal on purpose.
let dup = {"a": 1, "a": 2};
assert(dup["a"] == 2, "the last duplicate key wins");
assert(len(dup) == 1, "one entry, not two");

# A statement after return never runs: were it to run, the print
# would break this suite, which demands silence. --check warns.
fn after_return() {
  return "left";
  print("unreachable");
}
assert(after_return() == "left", "return leaves at once");

# A pause is a pause: it costs at least what it asks for, never less.
let before = time_ms();
sleep_ms(10);
assert(time_ms() - before >= 5, "sleep_ms waits");
assert(sleep_ms(0) == nil, "and returns nil");
let slept = try(sleep_ms, -1);
assert(contains(slept["err"], "negative"), "a negative pause is an error");

# 877: the clock for measuring, as opposed to the clock for dates. It
# is a float, it never goes backwards, and a pause shows up in it.
let mark = mono_ms();
assert(type(mark) == "float", "mono_ms is a float");
sleep_ms(10);
let waited = mono_ms() - mark;
assert(waited >= 5.0, "a pause costs time on the monotonic clock");
assert(waited < 60000.0, "and not absurdly much");
let first = mono_ms();
let second = mono_ms();
assert(second >= first, "readings never go backwards");

let err = import("lib/err.ting")["message"];

# run() refuses what it cannot make sense of. Which programs exist is
# a property of the machine, so the selftest checks only the refusals;
# tests/io.rs drives a real child.
assert(starts_with(err(fn() { return run("ting-no-such-program-xyz"); }), "run: cannot start "),
"a missing program is an error, not an exit code");
assert(err(fn() { return run(1); }) == "run expects a program name, got int", "the program is a string");
assert(err(fn() { return run("echo", "hi"); }) == "run expects a list of arguments, got string",
"argv is a list, not a shell string");
assert(err(fn() { return run("echo", [1]); }) == "run expects a list of strings, got int in it",
"argv holds strings");
# The third argument is stdin as a string, or a map of options. An
# option nothing knows is refused rather than quietly ignored: a
# misspelled one that changes nothing is a bug a script cannot see.
assert(err(fn() { return run("echo", [], 7); })
== "run expects stdin as a string or options as a map, got int",
"the third argument is stdin or options");
assert(err(fn() { return run("echo", [], {"dri": "/tmp"}); })
== "run: no option `dri` (did you mean `dir`?)", "a near miss is named");
assert(err(fn() { return run("echo", [], {"shell": true}); })
== "run: no option `shell` (the options are `dir`, `env` and `stdin`)",
"and so are the options");
assert(err(fn() { return run("echo", [], {"env": "X=y"}); })
== "run: env must be a map, got string", "env is a map of names to values");
assert(err(fn() { return run("echo", [], {"env": {"X": 7}}); })
== "run: env `X` must be a string or nil, got int", "a value is text, or nil to unset it");
assert(err(fn() { return run("echo", [], {"env": {"A=B": "y"}}); })
== "run: \"A=B\" is not an environment variable name", "a name with an = in it is not one");
assert(err(fn() { return run("echo", [], {"env": {"": "y"}}); })
== "run: \"\" is not an environment variable name", "and neither is nothing");
assert(err(fn() { return run("echo", [], {"dir": 7}); })
== "run: dir must be a string, got int", "an option has a type");
assert(err(fn() { return run("echo", [], {"dir": "ting-no-such-directory-xyz"}); })
== "run: no directory at \"ting-no-such-directory-xyz\" to run in",
"a missing directory is not a missing program");

# cwd() is a path, and a script standing in it can see itself listed.
assert(len(cwd()) > 0, "the working directory is a string");
assert(exists(cwd()) && is_dir(cwd()), "and it is a directory that exists");
assert(err(fn() { return cwd(1); }) == "cwd expects 0 arguments, got 1", "cwd takes nothing");
# eprint says nothing on stdout, which is what keeps this suite silent.
assert(eprint() == nil, "eprint returns nil");

# A value nested deeper than printing follows ends in the marker that
# a cycle uses, rather than killing the process: the walker recursed
# per level and died somewhere past 100000, having gone quadratic long
# before that. json_str refuses the same depth instead, because a
# truncated document would not be JSON.
fn deep(n) {
  let xs = [];
  for i in range(0, n) { xs = [xs]; }
  return xs;
}
let shown = str(deep(500));
assert(!contains(shown, "[...]"), "a value within the depth prints whole");
let stopped = str(deep(5000));
assert(contains(stopped, "[...]"), "past it the marker stands in for the rest");
assert(len(stopped) == len(str(deep(50000))), "however much deeper it goes");
let refused = try(json_str, deep(5000));
assert(contains(refused["err"], "nested deeper than 1000"),
"json_str refuses what json_parse would not read back");
