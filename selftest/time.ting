# ting testing ting: civil dates, both directions.

let t = import("lib/time.ting");

assert(t["iso"](0) == "1970-01-01T00:00:00Z", "the epoch itself");
assert(t["iso"](-1) == "1969-12-31T23:59:59Z", "one millisecond before it");
assert(t["iso"](86399999) == "1970-01-01T23:59:59Z", "the last second of day one");
assert(t["date"](951782400000) == "2000-02-29", "a leap day exists");
assert(t["clock"](951825296000) == "11:54:56", "time of day");

# Round trip: every date reads back as the milliseconds it came from.
for ms in [0, 1, -1, 1000, 86400000, -86400000, 951782400000, 1788552563646, -2208988800000] {
  let p = t["parts"](ms);
  let back = t["from_parts"](p["year"], p["month"], p["day"], p["hour"], p["minute"], p["second"]);
  assert(back + p["ms"] == ms, "round trip " + str(ms));
}

# Day counting agrees with itself across four centuries.
let day = 0;
for year in [1970, 1999, 2000, 2001, 2024, 2100, 2400] {
  let first = t["days_from_civil"](year, 1, 1);
  let last = t["days_from_civil"](year, 12, 31);
  let length = 365;
  if t["is_leap"](year) { length = 366; }
  assert(last - first == length - 1, "year length " + str(year));
  day = first;
}

assert(t["is_leap"](2000) && !t["is_leap"](1900) && t["is_leap"](2024), "the century rules");
assert(t["days_in_month"](2024, 2) == 29 && t["days_in_month"](2023, 2) == 28, "February");
assert(t["days_in_month"](2024, 12) == 31, "December");
assert(contains(try(fn() { return t["days_in_month"](2024, 13); })["err"], "out of range"), "no month 13");

assert(t["parts"](0)["weekday"] == 4, "the epoch was a Thursday");
assert(t["weekday_name"](0) == "Sunday" && t["weekday_name"](4) == "Thursday", "weekday names");
assert(contains(try(fn() { return t["weekday_name"](7); })["err"], "out of range"), "no eighth day");
assert(t["weekday_name"](3, true) == "Wed", "the short weekday the world writes");
assert(t["month_name"](1) == "January" && t["month_name"](12) == "December", "month names");
assert(t["month_name"](9, true) == "Sep", "and the short one");
assert(contains(try(fn() { return t["month_name"](0); })["err"], "out of range"), "no month zero");
# Both spellings and either case, which is what a log or a mail
# header hands over.
assert(t["month_number"]("September") == 9 && t["month_number"]("Sep") == 9, "September both ways");
assert(t["month_number"]("sep") == 9 && t["month_number"]("SEPTEMBER") == 9, "and either case");
assert(t["weekday_number"]("Sunday") == 0 && t["weekday_number"]("sat") == 6, "weekday numbers");
assert(contains(try(fn() { return t["month_number"]("Smarch"); })["err"], "not a month name"),
"a month nobody writes");
assert(contains(try(fn() { return t["weekday_number"](7); })["err"], "not a weekday name"),
"and a number is not a name");
# The tables are the names themselves, for a program that wants them
# all: a dropdown, a header row, a spelling check.
assert(len(t["MONTHS"]) == 12 && t["MONTHS"][8] == "September", "the twelve names");
assert(len(t["WEEKDAYS"]) == 7 && t["WEEKDAYS"][0] == "Sunday", "the seven, Sunday first");
assert(t["name_index"](t["MONTHS"], "dec") == 11, "name_index reads a prefix");
assert(t["name_index"](t["MONTHS"], "decade") == nil, "and refuses a longer word");

# A stamp in the shape the world writes it, read by the codes the
# world describes it with.
assert(t["iso"](t["parse"]("12/Sep/2026:06:00:01", "%d/%b/%Y:%H:%M:%S")) == "2026-09-12T06:00:01Z",
"an access log stamp");
assert(t["parse"]("2026-09-12 06:00:01", "%F %T") == t["from_iso"]("2026-09-12T06:00:01Z"),
"the shorthand codes are the long ones");
assert(t["parse"]("09/12/26", "%D") == t["from_iso"]("2026-09-12"), "and so is %D");
assert(t["parse"]("2026-09-12T06:00:01.250Z", "%FT%T.%L%z") ==
t["from_iso"]("2026-09-12T06:00:01.250Z"), "milliseconds and a Z");
assert(t["parse"]("06:00:01.25", "%T.%L") - t["parse"]("06:00:01", "%T") == 250,
"a short fraction is padded, not read as 25");
# An offset moves the instant, and both spellings of one are read.
assert(t["parse"]("12/Sep/2026:06:00:01 +0200", "%d/%b/%Y:%H:%M:%S %z") ==
t["from_iso"]("2026-09-12T04:00:01Z"), "an offset without a colon");
assert(t["parse"]("12 Sep 2026 06:00:01 -05:30", "%d %b %Y %T %z") ==
t["from_iso"]("2026-09-12T11:30:01Z"), "and one with");
# The weekday is implied by the date, so it is read and dropped.
assert(t["parse"]("Sat, 12 September 2026 06:00:01", "%a, %d %B %Y %T") ==
t["from_iso"]("2026-09-12T06:00:01Z"), "a full month name and a weekday");
assert(t["parse"]("2026-09-12 06:00:01 PM", "%F %T %p") ==
t["from_iso"]("2026-09-12T18:00:01Z"), "the afternoon");
assert(t["parse"]("2026-09-12 12:00:01 AM", "%F %T %p") ==
t["from_iso"]("2026-09-12T00:00:01Z"), "and midnight, which is twelve");
# syslog writes no year and pads the day with a space.
assert(t["parse"]("Sep  3 06:00:01", "%b %e %H:%M:%S", {"year": 2026}) ==
t["from_iso"]("2026-09-03T06:00:01Z"), "a syslog line, with the year supplied");
assert(t["parts"](t["parse"]("Sep  3 06:00:01", "%b %e %H:%M:%S"))["year"] == 1970,
"and 1970 when it is not");
# The text comes from the world, so a mismatch is an answer.
assert(t["parse"]("12/Sep/2026", "%d/%b/%Y:%H:%M:%S") == nil, "text that stops early");
assert(t["parse"]("12/Sep/2026:06:00:01 extra", "%d/%b/%Y:%H:%M:%S") == nil, "and text left over");
assert(t["parse"]("2026-13-01", "%F") == nil, "no thirteenth month");
assert(t["parse"]("2026-02-30", "%F") == nil, "nor a February 30th");
assert(t["parse"]("2026-09-12 13:00:01 PM", "%F %T %p") == nil, "nor a thirteenth afternoon hour");
assert(t["parse"](12, "%F") == nil, "nor a number where the text goes");
# The pattern is the program's own, so a code nobody defined fails.
assert(contains(try(fn() { return t["parse"]("x", "%Q"); })["err"], "not a pattern code"),
"a code that is not one");

assert(t["span"](999) == "999ms", "under a second reads in milliseconds");
assert(t["span"](1000) == "1s" && t["span"](61000) == "1m 1s", "seconds and minutes");
assert(t["span"](3723000) == "1h 2m 3s", "hours too");
assert(t["span"](-61000) == "-1m 1s", "a negative span keeps its sign");

assert(t["fdiv"](-1, 86400000) == -1 && t["fmod"](-1, 86400000) == 86399999, "floor division");

# A clock reading now must land in a plausible century.
let now = t["parts"](time_ms());
assert(now["year"] >= 2026 && now["year"] < 2100, "the clock reads a plausible year");

# Reading back what iso() writes, and refusing what is not a
# timestamp. The refusals are the point: the five lines a script
# writes without this turn "2026-13-45T99:99:99Z" into a number.
let from_iso = t["from_iso"];
assert(from_iso(t["iso"](1788652800000)) == 1788652800000, "iso and from_iso are inverses");
assert(from_iso("2026-09-06T12:34:56Z") == 1788698096000, "the shape iso writes");
assert(from_iso("2026-09-06") == 1788652800000, "a date on its own is midnight");
assert(from_iso("2026-09-06 12:34:56") == from_iso("2026-09-06T12:34:56Z"),
"a space reads like a T, which is what databases write");
assert(from_iso("2026-09-06T12:34") == 1788698040000, "seconds may be left out");
assert(from_iso("2026-09-06T12:34:56.789Z") == 1788698096789, "fractional seconds are milliseconds");
assert(from_iso("2026-09-06T12:34:56.1234567Z") == 1788698096123, "and longer fractions are dropped, not rounded");
assert(from_iso("2026-09-06T14:34:56+02:00") == from_iso("2026-09-06T12:34:56Z"),
"an offset is applied");
assert(from_iso("2026-09-06T07:34:56-0500") == from_iso("2026-09-06T12:34:56Z"),
"in either spelling");
assert(from_iso("1969-12-31T23:59:59Z") == -1000, "before the epoch counts backwards");
assert(from_iso("2024-02-29") != nil, "a leap day exists");
assert(from_iso("2023-02-29") == nil, "except in the years it does not");
assert(from_iso("2026-02-30") == nil, "February has no thirtieth");
assert(from_iso("2026-13-45T99:99:99Z") == nil, "nor does any month have a forty-fifth day");
assert(from_iso("2026-09-06T24:00:00Z") == nil, "an hour is under 24");
assert(from_iso("2026-09-06T12:60:00Z") == nil, "a minute is under 60");
assert(from_iso("2026-09-06T12:34:60Z") == nil, "a leap second cannot be represented, so it is refused");
assert(from_iso("2026/09/06") == nil, "the separators are dashes");
assert(from_iso("not a date") == nil, "and what is not a date at all is nil, not an error");
assert(from_iso("") == nil, "including nothing");
assert(from_iso(3) == nil, "and what is not a string");
assert(t["digits"]("0123") && !t["digits"]("12a") && !t["digits"](""), "digits is all of them and at least one");

# The local zone, which the platform keeps rather than this language.
# A machine that keeps nothing to read — the browser playground, or a
# TZ carrying a rule rather than a name — answers nil, and the point
# of nil is that a script can tell it apart from a real zero offset.
# So everything below holds either way.
let err = import("lib/err.ting")["message"];
let here = local_zone();
assert(here == nil || type(here) == "map", "the local zone is a map or nothing");
if here != nil {
  assert(type(here["offset"]) == "int", "an offset in milliseconds");
  assert(type(here["abbr"]) == "string" && len(here["abbr"]) > 0, "the zone's own abbreviation");
  assert(type(here["dst"]) == "bool", "and whether it is summer time");
  # No zone has ever been more than fifteen hours from UTC, and every
  # offset is a whole number of seconds — but NOT of minutes: an old
  # enough instant lands in local mean time, which Zurich kept at
  # 29 minutes 46 seconds.
  assert(here["offset"] > -15 * 3600000 && here["offset"] < 15 * 3600000, "and it is a real offset");
  assert(here["offset"] % 1000 == 0, "a whole number of seconds");
  # The same instant is the same answer, whenever it is asked.
  let at = 1784116800000;
  assert(local_zone(at) == local_zone(at), "an instant has one answer");
  assert(str(local_zone(at)) == str(local_zone(at)), "which does not drift between calls");
}

# What it refuses. An instant is a number of milliseconds, like the
# one time_ms and stat hand out.
assert(err(fn() { return local_zone("2026-01-01"); }) ==
"local_zone expects an instant in milliseconds, got string",
"a date is not an instant");
assert(contains(err(fn() { return local_zone(1, 2); }), "local_zone"), "and it takes at most one");

# Writing an instant where a zone is involved. offset_iso is pure, so
# it can be checked anywhere; the three that ask the platform are
# checked only where the platform answers.
assert(t["offset_iso"](0) == "Z", "no offset is Z, as iso writes it");
assert(t["offset_iso"](3600000) == "+01:00", "an hour east");
assert(t["offset_iso"](-18000000) == "-05:00", "and five hours west");
assert(t["offset_iso"](19800000) == "+05:30", "a half-hour zone");
assert(t["offset_iso"](-12600000) == "-03:30", "in both directions");
assert(t["offset_iso"](50400000) == "+14:00", "the furthest east anyone is");
# ISO has no room for seconds in an offset. The local mean times
# before about 1900 have them, and they are truncated towards zero,
# which is what date prints for them too.
assert(t["offset_iso"](1786000) == "+00:29", "29 minutes 46 seconds, written as 29");
assert(t["offset_iso"](-1786000) == "-00:29", "and the same going west");

let sample = 1784116800000;
if local_zone(sample) == nil {
  assert(t["local_date"](sample) == nil, "no zone data, no local day");
  assert(t["local_clock"](sample) == nil, "nor a local time of day");
  assert(t["local_iso"](sample) == nil, "nor an instant that carries one");
} else {
  let off = local_zone(sample)["offset"];
  assert(t["local_date"](sample) == t["date"](sample + off), "the local day is the shifted day");
  assert(t["local_clock"](sample) == t["clock"](sample + off), "and so is the time of day");
  assert(t["local_iso"](sample) == t["date"](sample + off) + "T" + t["clock"](sample + off) +
  t["offset_iso"](off), "and the instant carries the offset");
  # The round trip is the point of carrying it: from_iso reads back
  # the instant, not the local reading of it. Whole-minute offsets
  # only — the pre-1900 ones lose their seconds, as ISO requires.
  if off % 60000 == 0 {
    assert(t["from_iso"](t["local_iso"](sample)) == sample, "and reads back to the same instant");
  }
}

# Writing an instant in a stated shape. text takes the codes parse
# takes, so the two are inverses over the same vocabulary.
let log = t["parse"]("12/Sep/2026:06:00:01", "%d/%b/%Y:%H:%M:%S");
assert(t["text"](log, "%d/%b/%Y:%H:%M:%S") == "12/Sep/2026:06:00:01", "an access log stamp");
assert(t["text"](log, "%b %e %H:%M:%S") == "Sep 12 06:00:01", "a syslog stamp");
assert(t["text"](log, "%F %T") == "2026-09-12 06:00:01", "the two shorthands");
assert(t["text"](log, "%D") == "09/12/26", "and the third");
assert(t["text"](log, "%A, %B %d, %Y") == "Saturday, September 12, 2026", "names in full");
assert(t["text"](log, "%a %b") == "Sat Sep", "and in three letters");
assert(t["text"](log, "%y") == "26", "a two-digit year");
assert(t["text"](t["from_parts"](1969, 7, 20, 20, 17, 40), "%y") == "69", "in either century");
assert(t["text"](log, "%L") == "000", "milliseconds are three digits");
assert(t["text"](log + 7, "%L") == "007", "padded, not printed as they are");
assert(t["text"](log, "100%% done at %H:%M") == "100% done at 06:00", "a literal percent");
assert(t["text"](log, "no codes here") == "no codes here", "a pattern that names nothing");

# The day pads with a space, which is what %e is for: syslog columns
# line up because "Sep  3" is as wide as "Sep 12".
assert(t["text"](t["from_parts"](2026, 9, 3, 0, 0, 0), "%b %e") == "Sep  3", "a single-digit day");
assert(t["text"](t["from_parts"](2026, 9, 3, 0, 0, 0), "%b %d") == "Sep 03", "which %d pads with a zero");

# The twelve-hour clock, folded where it is written rather than left
# to the reader: midnight and noon are both twelve.
assert(t["text"](t["from_parts"](2026, 1, 2, 0, 30, 0), "%I:%M %p") == "12:30 AM", "midnight is twelve AM");
assert(t["text"](t["from_parts"](2026, 1, 2, 12, 0, 0), "%I:%M %p") == "12:00 PM", "noon is twelve PM");
assert(t["text"](t["from_parts"](2026, 1, 2, 11, 59, 0), "%I %p") == "11 AM", "the minute before it");
assert(t["text"](t["from_parts"](2026, 1, 2, 13, 0, 0), "%I %p") == "01 PM", "and the hour after");

# An offset shifts the instant and is what %z writes. Without one
# everything here is UTC, so %z would only ever say +0000.
assert(t["text"](log, "%H:%M%z") == "06:00+0000", "no offset is written, not skipped");
assert(t["text"](log, "%H:%M%z", 7200000) == "08:00+0200", "two hours east");
assert(t["text"](log, "%H:%M%z", -19800000) == "00:30-0530", "a half-hour zone west");
assert(t["parse"](t["text"](log, "%FT%T%z", 7200000), "%FT%T%z") == log, "and it reads back to the instant");

# The round trip, over every shape that keeps the whole instant.
for pattern in ["%F %T", "%d/%b/%Y:%H:%M:%S", "%Y%m%d%H%M%S", "%D %T", "%B %e, %Y %I:%M:%S %p"] {
  assert(t["parse"](t["text"](log, pattern), pattern) == log, "round trip " + pattern);
}
assert(t["parse"](t["text"](log + 250, "%F %T.%L"), "%F %T.%L") == log + 250, "milliseconds included");

# A code nobody defined fails here too: the pattern is the program's
# own, and a silent nothing would hide the typo.
assert(err(fn() { return t["text"](log, "%Q"); }) == "not a pattern code: %Q", "an unknown code");
