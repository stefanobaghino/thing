# ting testing ting: parameters that can be left out.

fn greet(name, greeting = "hello") { return greeting + ", " + name; }
assert(greet("ting") == "hello, ting", "default is used when omitted");
assert(greet("ting", "hi") == "hi, ting", "default is overridden when given");

# Arity is still checked, now as a range.
fn two(a, b = 2, c = 3) { return [a, b, c]; }
assert(two(1) == [1, 2, 3], "all defaults");
assert(two(1, 9) == [1, 9, 3], "some defaults");
assert(two(1, 9, 8) == [1, 9, 8], "no defaults");
let call = two;
let few = try(call);
assert(contains(few["err"], "two expects 1 to 3 arguments, got 0"), "too few names the range");
let many = try(call, 1, 2, 3, 4);
assert(contains(many["err"], "two expects 1 to 3 arguments, got 4"), "too many names the range");

# A default is an expression, evaluated at the call.
let n = 1;
fn current() { return n; }
assert(current() == 1, "default sees the binding");
n = 2;
assert(current() == 2, "and sees it again, freshly");

# Defaults are evaluated left to right, so a later one may name an
# earlier parameter — including one the caller supplied.
fn span(from, to = from + 10, size = to - from) { return [from, to, size]; }
assert(span(1) == [1, 11, 10], "later defaults see earlier ones");
assert(span(1, 4) == [1, 4, 3], "and see the arguments as given");

# Each call builds its own value, so mutable defaults do not leak.
fn collect(x, into = []) { push(into, x); return into; }
assert(collect(1) == [1], "fresh list");
assert(collect(2) == [2], "still fresh on the next call");
let shared = [];
assert(collect(1, shared) == [1] && collect(2, shared) == [1, 2], "an explicit list is kept");

# A default can call a function, including the one being defined's peers.
fn twice(x) { return x * 2; }
fn scale(x, by = twice(3)) { return x * by; }
assert(scale(2) == 12, "a default may call");

# Closures carry their defaults with them.
fn make(step = 5) { return fn(x, s = step) { return x + s; }; }
assert(make()(1) == 6, "captured default");
assert(make(2)(1) == 3, "captured default from an argument");

# Defaults work under higher-order use, where the caller passes one
# argument and the rest fill themselves in.
fn tag(s, mark = "!") { return s + mark; }
assert(map(["a", "b"], tag) == ["a!", "b!"], "map supplies one argument");
