# ting testing ting: lists, maps, and the container builtins.

let xs = [1, 2, 3];
assert(len(xs) == 3, "list len");
assert(xs[0] == 1 && xs[-1] == 3, "indexing");
assert([1, 2] + [3] == [1, 2, 3], "list concat");
assert([1, [2, 3]] == [1, [2, 3]], "deep structural equality");

# Reference semantics: aliases share storage; + [] copies.
let alias = xs;
alias[0] = 99;
assert(xs[0] == 99, "aliases share");
let copy = xs + [];
copy[0] = 1;
assert(xs[0] == 99 && copy[0] == 1, "copy is independent");

push(xs, 4);
assert(len(xs) == 4 && pop(xs) == 4 && len(xs) == 3, "push/pop");
let popped = try(pop, []);
assert(has(popped, "err"), "pop of empty errors");

let m = {"b": 2, "a": 1};
assert(len(m) == 2 && m["a"] == 1, "map basics");
m["c"] = 3;
assert(keys(m) == ["a", "b", "c"], "keys sorted");
assert(has(m, "a") && !has(m, "z"), "has");
assert(get(m, "a", 0) == 1 && get(m, "z", 0) == 0, "get on a map");
assert(get([10, 20], 1, -1) == 20 && get([10, 20], 9, -1) == -1, "get on a list");
assert(get([10, 20], -1, -1) == 20, "get counts back from the end");
assert(get("abc", 1, "?") == "b" && get("abc", 9, "?") == "?", "get on a string");
assert(has(try(get, [1], "k", 0), "err"), "get still errs on an unindexable pair");
let missing = try(fn() { return m["z"]; });
assert(has(missing, "err"), "missing key errors");

# 917: a map can be emptied as well as filled. Before pop took a key,
# the only way was to rebuild the map without it.
let took = pop(m, "b");
assert(took == 2, "pop hands back the value it removed");
assert(len(m) == 2 && !has(m, "b"), "and the key is gone");
m["b"] = 2;
assert(len(m) == 3 && m["b"] == 2, "the same map fills again");
let alias = m;
pop(alias, "b");
assert(!has(m, "b"), "pop is in place, so an alias sees it");
assert(has(try(pop, m, "b"), "err"), "popping a key twice errors");
assert(has(try(pop, m), "err"), "a map wants the key to take out");
assert(has(try(pop, [1, 2], "k"), "err"), "a list takes no key");
m["b"] = 2;
# What `m[k] = nil` does instead, which is not this.
m["b"] = nil;
assert(len(m) == 3 && has(m, "b") && m["b"] == nil, "assigning nil keeps the key");
assert(pop(m, "b") == nil && !has(m, "b"), "pop removes it, nil and all");

assert(sort([3, 1, 2]) == [1, 2, 3], "sort");
assert(sort_by(["bbb", "a", "cc"], len) == ["a", "cc", "bbb"], "sort_by");
assert(map([1, 2, 3], fn(x) { return x * 2; }) == [2, 4, 6], "map");
assert(filter(range(6), fn(x) { return x % 2 == 0; }) == [0, 2, 4], "filter");
assert(reduce([1, 2, 3], 100, fn(a, x) { return a + x; }) == 106, "reduce");
assert(min([3, 1, 2]) == 1 && max([3, 1, 2]) == 3, "min/max");
assert(range(2, 5) == [2, 3, 4], "range is half-open");
assert(slice([1, 2, 3, 4], 1, -1) == [2, 3], "list slice");

# 830: `for x in range(...)` counts rather than building the list.
# The values, the edges and the shadowing all have to answer exactly
# as the list did, on both engines.
let seen = [];
for i in range(3) { push(seen, i); }
assert(seen == [0, 1, 2], "fused range: one argument");
seen = [];
for i in range(2, 5) { push(seen, i); }
assert(seen == [2, 3, 4], "fused range: two arguments");
seen = [];
for i in range(3, 0, -1) { push(seen, i); }
assert(seen == [3, 2, 1], "fused range: negative step");
seen = [];
for i in range(0) { push(seen, i); }
assert(seen == [], "fused range: empty");
seen = [];
for i in range(5, 5) { push(seen, i); }
assert(seen == [], "fused range: empty by equal bounds");
seen = [];
for i in range(0, 5, 2) { push(seen, i); }
assert(seen == [0, 2, 4], "fused range: step past the end");
seen = [];
for i in range(100) { if i > 2 { break; } push(seen, i); }
assert(seen == [0, 1, 2], "fused range: break");
seen = [];
for i in range(5) { if i % 2 == 0 { continue; } push(seen, i); }
assert(seen == [1, 3], "fused range: continue");
seen = [];
for i in range(2) { for j in range(2) { push(seen, [i, j]); } }
assert(seen == [[0, 0], [0, 1], [1, 0], [1, 1]], "fused range: nested");
let fns = [];
for i in range(3) { push(fns, fn() { return i; }); }
assert(map(fns, fn(f) { return f(); }) == [0, 1, 2], "fused range: captured loop variable");
# The fusion is decided at run time, because `range` is an ordinary
# name a program may bind — and the REPL binds it in an earlier chunk
# than the loop.
fn shadowing_range_wins() {
  let range = fn(_n) { return ["a", "b"]; };
  let out = [];
  for i in range(3) { push(out, i); }
  return out;
}
assert(shadowing_range_wins() == ["a", "b"], "a shadowed range wins over the builtin");

let errmsg = import("lib/err.ting")["message"];
assert(errmsg(fn() { for i in range(1, 2, 0) { print(i); } }) == "range step must not be 0",
"fused range: step 0 errors as the builtin does");
assert(errmsg(fn() { for i in range("a") { print(i); } }) == "range expects int arguments",
"fused range: a bad argument errors as the builtin does");
assert(errmsg(fn() { for i in range() { print(i); } }) == "range expects 1 to 3 arguments, got 0",
"fused range: arity errors as the builtin does");

# fingerprint: a map key exactly where == is an equivalence relation,
# and nil everywhere it is not.
assert(type(fingerprint(1)) == "string", "fingerprint answers a string");
assert(fingerprint(1) == fingerprint(1.0), "fingerprint: 1 and 1.0 are one value, as == says");
assert(fingerprint([1]) == fingerprint([1.0]), "fingerprint: and nested, as == says there too");
assert(fingerprint({"a": 1}) == fingerprint({"a": 1.0}), "fingerprint: map values too");
assert(fingerprint(0.0) == fingerprint(-0.0), "fingerprint: zero has one spelling");
assert(fingerprint("1") != fingerprint(1), "fingerprint: a string is not the number it spells");
assert(fingerprint([1, "1"]) != fingerprint(["1", 1]), "fingerprint: order counts");
assert(fingerprint({"a": 1}) != fingerprint({"b": 1}), "fingerprint: keys count");
assert(fingerprint(["ab"]) != fingerprint(["a", "b"]), "fingerprint: a string carries its length");
assert(fingerprint(true) != fingerprint("true"), "fingerprint: a bool is not its name");
assert(fingerprint(nil) != nil, "fingerprint: nil is a value like any other");

assert(fingerprint(print) == nil, "fingerprint refuses a builtin");
assert(fingerprint(fn(x) { return x; }) == nil, "fingerprint refuses a function");
assert(fingerprint([1, print]) == nil, "fingerprint refuses a function inside");
assert(fingerprint({"f": print}) == nil, "fingerprint refuses one under a key");
assert(fingerprint(9007199254740992) != nil, "fingerprint keeps 2^53 itself");
assert(fingerprint(9007199254740993) == nil, "fingerprint refuses an int past 2^53");
assert(fingerprint(0.0 / 0.0) == nil, "fingerprint refuses a NaN, which equals nothing");
let cyc = [1];
push(cyc, cyc);
assert(fingerprint(cyc) == nil, "fingerprint refuses a value that holds itself");
let selfmap = {"a": 1};
selfmap["self"] = selfmap;
assert(fingerprint(selfmap) == nil, "fingerprint refuses a map that holds itself");
assert(errmsg(fn() { return fingerprint(); }) == "fingerprint expects 1 argument, got 0",
"fingerprint takes one value");
