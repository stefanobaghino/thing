# ting testing ting: lists, maps, and the container builtins.

let xs = [1, 2, 3];
assert(len(xs) == 3, "list len");
assert(xs[0] == 1 && xs[-1] == 3, "indexing");
assert([1, 2] + [3] == [1, 2, 3], "list concat");
assert([1, [2, 3]] == [1, [2, 3]], "deep structural equality");

# Reference semantics: aliases share storage; + [] copies.
let alias = xs;
alias[0] = 99;
assert(xs[0] == 99, "aliases share");
let copy = xs + [];
copy[0] = 1;
assert(xs[0] == 99 && copy[0] == 1, "copy is independent");

push(xs, 4);
assert(len(xs) == 4 && pop(xs) == 4 && len(xs) == 3, "push/pop");
let popped = try(pop, []);
assert(has(popped, "err"), "pop of empty errors");

let m = {"b": 2, "a": 1};
assert(len(m) == 2 && m["a"] == 1, "map basics");
m["c"] = 3;
assert(keys(m) == ["a", "b", "c"], "keys sorted");
assert(has(m, "a") && !has(m, "z"), "has");
let missing = try(fn() { return m["z"]; });
assert(has(missing, "err"), "missing key errors");

assert(sort([3, 1, 2]) == [1, 2, 3], "sort");
assert(sort_by(["bbb", "a", "cc"], len) == ["a", "cc", "bbb"], "sort_by");
assert(map([1, 2, 3], fn(x) { return x * 2; }) == [2, 4, 6], "map");
assert(filter(range(6), fn(x) { return x % 2 == 0; }) == [0, 2, 4], "filter");
assert(reduce([1, 2, 3], 100, fn(a, x) { return a + x; }) == 106, "reduce");
assert(min([3, 1, 2]) == 1 && max([3, 1, 2]) == 3, "min/max");
assert(range(2, 5) == [2, 3, 4], "range is half-open");
assert(slice([1, 2, 3, 4], 1, -1) == [2, 3], "list slice");
