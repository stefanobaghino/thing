# ting testing ting: strictness and error recovery.

# No truthiness anywhere.
let cond = try(fn() { if 1 { } });
assert(has(cond, "err"), "non-bool condition errors");
let andint = try(fn() { return 1 && true; });
assert(has(andint, "err"), "non-bool && errors");

# No implicit conversions.
let mixed = try(fn() { return 1 + "x"; });
assert(contains(mixed["err"], "int"), "mixed + names the types");

# try/fail round trip.
let r = try(fn() { fail("boom"); });
assert(r["err"] == "boom", "fail message travels");
let ok = try(fn() { return 42; });
assert(ok["ok"] == 42, "success shape");
assert(!has(ok, "err"), "no err key on success");

# try(f) recovers and the program continues — this very line proves it.
let bounds = try(fn() { return [1][5]; });
assert(has(bounds, "err"), "out of bounds errors");

# assert itself: failure is a catchable error with the message.
let a = try(fn() { assert(false, "the message"); });
assert(contains(a["err"], "the message"), "assert message");
let strict = try(fn() { assert(1); });
assert(contains(strict["err"], "bool"), "assert demands a bool");

# Errors name the nearest thing they know about.
let total = 1;
assert(total == 1, "total is bound");
let typo = try(fn() { return totl; });
assert(contains(typo["err"], "did you mean 'total'"), "undefined variable suggests");
let m = {"alpha": 1};
let key = try(fn() { return m["alpah"]; });
assert(contains(key["err"], "did you mean \"alpha\""), "unknown key suggests");
let far = try(fn() { return m["zqxjw"]; });
assert(!contains(far["err"], "did you mean"), "nothing near, nothing said");

# Arity errors count in plain English and name the function called.
let one = try(fn() { return len(); });
assert(contains(one["err"], "len expects 1 argument, got 0"), "one argument, singular");
let many = try(fn() { return range(1, 2, 3, 4); });
assert(contains(many["err"], "range expects 1 to 3 arguments, got 4"), "a range of arities");
fn two(a, b) { return a + b; }
fn apply(f) { return f(1); }
let user = try(fn() { return apply(two); });
assert(contains(user["err"], "two expects 2 arguments, got 1"), "the callee is named");
let anon = try(fn() { return apply(fn(a, b) { return a + b; }); });
assert(contains(anon["err"], "an anonymous function expects 2 arguments"), "a literal has no name");
let fmt = try(fn() { return format("{}", 1, 2); });
assert(contains(fmt["err"], "1 placeholder but 2 value arguments"), "placeholders count too");

# try() hands back where the failure happened and the calls it came
# out of, not just the message.
let raised = try(fn() { fail("here"); });
let next_line = try(fn() { fail("there"); });
assert(next_line["at"]["line"] == raised["at"]["line"] + 1, "consecutive lines count up");
assert(contains(raised["at"]["file"], "errors.ting"), "the file is named");
assert(raised["at"]["col"] > 0, "a column too");
fn middle(x) { return x + "a"; }
fn outermost(x) { return middle(x); }
let deep = try(fn() { return outermost(1); });
assert(len(deep["trace"]) == 3, "one frame per call");
assert(deep["trace"][0]["fn"] == "middle", "innermost frame first");
assert(deep["trace"][1]["fn"] == "outermost", "then its caller");
assert(deep["trace"][2]["fn"] == nil, "the literal try() called has no name");
assert(deep["trace"][0]["line"] == deep["at"]["line"] + 1, "frames carry their call site");
