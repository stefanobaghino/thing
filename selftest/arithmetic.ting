# ting testing ting: numbers, comparisons, equality.

assert(1 + 2 * 3 == 7, "precedence");
assert((1 + 2) * 3 == 9, "grouping");
assert(7 / 2 == 3, "int division truncates");
assert(7 % 2 == 1, "remainder");
assert(7.0 / 2 == 3.5, "mixed division promotes");
assert(1 + 0.5 == 1.5, "mixed addition promotes");
assert(-5 + 3 == -2, "unary minus");
assert(abs(-42) == 42, "abs int");
assert(abs(-1.5) == 1.5, "abs float");

# Literals: radix prefixes and digit separators.
assert(0xff == 255, "hex literal");
assert(0xFF_FF == 65535, "hex is case-insensitive and separable");
assert(0b1010 == 10, "binary literal");
assert(0b1_0 == 2, "binary separator");
assert(1_000_000 == 1000000, "decimal separator");
assert(1_0.5 == 10.5, "separator in a float");
assert(0x7fffffffffffffff == 9223372036854775807, "hex reaches the top of the range");

assert(1 == 1.0, "numeric equality crosses int/float");
assert(1 != 2, "inequality");
assert(!(1 == "1"), "no string/number equality");
assert(1 < 1.5 && 1.5 < 2, "mixed comparison");
assert("a" < "b", "string ordering");
assert(2 <= 2 && 2 >= 2, "non-strict bounds");

let overflow = try(fn() { return 9223372036854775807 + 1; });
assert(has(overflow, "err"), "overflow is an error");
assert(contains(overflow["err"], "overflow"), "overflow message");

let div0 = try(fn() { return 1 / 0; });
assert(div0["err"] == "division by zero", "int division by zero");
assert(1.0 / 0.0 > 9999999.0, "float division gives infinity");
