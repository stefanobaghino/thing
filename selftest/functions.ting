# ting testing ting: functions, closures, control flow.

fn add(a, b) { return a + b; }
assert(add(2, 3) == 5, "function call");
assert(add == add, "function identity equality");

# Closures share their captured environment.
fn make_counter() {
  let n = 0;
  fn tick() { n = n + 1; return n; }
  return tick;
}
let c1 = make_counter();
let c2 = make_counter();
assert(c1() == 1 && c1() == 2 && c2() == 1, "independent closures");

# Recursion and the depth cap.
fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); }
assert(fib(15) == 610, "recursion");
fn forever() { return forever(); }
let deep = try(forever);
assert(contains(deep["err"], "stack overflow"), "depth cap trips cleanly");

# Builtins are values; arity is exact.
let f = len;
assert(f("abc") == 3, "builtin as value");
let wrong = try(fn() { return add(1); });
assert(has(wrong, "err"), "arity checked");

# Falling off the end returns nil; bare functions are truthy nowhere.
fn nothing() { }
assert(nothing() == nil, "implicit nil return");

# Per-iteration loop binding: closures capture that iteration's value.
let fs = [];
for x in range(3) {
  push(fs, fn() { return x; });
}
assert(fs[0]() == 0 && fs[1]() == 1 && fs[2]() == 2, "loop binding");

# break/continue.
let total = 0;
for n in range(10) {
  if n == 5 { break; }
  if n % 2 == 1 { continue; }
  total += n;
}
assert(total == 6, "break and continue");

# while with mutation.
let i = 0;
while i < 5 { i = i + 1; }
assert(i == 5, "while");

# for over a string and a map.
let chars = [];
for ch in "héllo" { push(chars, ch); }
assert(join(chars, "") == "héllo", "for over chars");
let seen = [];
for k in {"b": 1, "a": 2} { push(seen, k); }
assert(seen == ["a", "b"], "for over sorted keys");

# A frame whose closures only reference each other is released when
# the call ends (863: a recursive helper leaked its frame per call).
# What must survive it: everything that escaped the frame.
fn maker(n) {
  fn helper(k) { if k <= 0 { return n; } return helper(k - 1) + 1; }
  return helper;
}
assert(maker(10)(3) == 13, "a returned recursive closure keeps its frame");

fn pair() {
  let count = 0;
  fn bump() { count += 1; return count; }
  fn read() { return count; }
  return [bump, read];
}
let both = pair();
both[0]();
both[0]();
assert(both[1]() == 2, "closures returned together share one frame");

fn boxed(n) {
  let box = [];
  fn inner(k) { if k <= 0 { return n; } return inner(k - 1); }
  push(box, inner);
  return box;
}
assert(boxed(7)[0](2) == 7, "a closure escaping inside a list keeps its frame");

fn mutual() {
  fn even(k) { if k == 0 { return true; } return odd(k - 1); }
  fn odd(k) { if k == 0 { return false; } return even(k - 1); }
  return even;
}
assert(mutual()(10) && !mutual()(7), "mutually recursive helpers survive the return");

fn mapped(n) {
  let m = {};
  fn fetch() { return n; }
  m["get"] = fetch;
  return m;
}
assert(mapped(42)["get"]() == 42, "a closure escaping inside a map keeps its frame");

let counted = 0;
{
  let inside = 5;
  fn nudge() { inside += 1; return inside; }
  counted = nudge() + nudge();
}
assert(counted == 13, "a block's closures see the block's bindings");

let per = [];
for step in [1, 2, 3] {
  fn each() { return step; }
  push(per, each);
}
assert([per[0](), per[1](), per[2]()] == [1, 2, 3], "one frame per iteration");
