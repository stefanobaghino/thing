# ting testing ting: driving other programs. Which programs a machine
# has is not something a portable suite may assume, so the checks that
# need a child ask which() first and stand down when there is none.

let sh = import("lib/sh.ting");
let err = import("lib/err.ting")["message"];

assert(type(sh["windows"]()) == "bool", "the platform question has a yes or no answer");
assert(sh["dir_sep"]() == "/" || sh["dir_sep"]() == "\\", "a separator is one of two things");

# PATH is a list of non-empty directory names. Counted as ONE check
# rather than one per entry: how long a machine's PATH is is not a
# property of this suite, and asserting per entry made the suite's
# total differ on every machine that ran it — 82 entries on a Windows
# runner against 11 here, which is 71 phantom checks.
let dirs = sh["path_dirs"]();
assert(type(dirs) == "list", "PATH splits into a list");
let empty = 0;
for dir in dirs { if dir == "" { empty += 1; } }
assert(empty == 0, "no empty entry survives the split");

# A name nothing could answer to is nil, not a guess.
assert(sh["which"]("ting-definitely-no-such-program-xyz") == nil, "which misses cleanly");

# A missing program is an error from run(), through every wrapper.
assert(starts_with(err(fn() { return sh["check"]("ting-no-such-program-xyz", []); }),
"run: cannot start "), "check reports a missing program as run does");
assert(starts_with(err(fn() { return sh["ok"]("ting-no-such-program-xyz", []); }),
"run: cannot start "), "so does ok");

# Where there is a shell, drive it.
let shell = sh["which"]("sh");
if shell != nil {
  assert(sh["ok"](shell, ["-c", "exit 0"]), "a happy program is ok");
  assert(!sh["ok"](shell, ["-c", "exit 1"]), "an unhappy one is not");
  assert(sh["check"](shell, ["-c", "printf hello"]) == "hello", "check hands back stdout");
  assert(sh["lines"](shell, ["-c", "printf 'a\nb\n'"]) == ["a", "b"],
  "the trailing newline leaves no empty line behind");
  assert(sh["lines"](shell, ["-c", "printf ''"]) == [], "no output is no lines");
  let bad = err(fn() { return sh["check"](shell, ["-c", "echo why 1>&2; exit 4"]); });
  assert(contains(bad, "exited 4") && contains(bad, "why"),
  "a nonzero code fails with the code and the reason");
  let quiet = err(fn() { return sh["check"](shell, ["-c", "exit 7"]); });
  assert(contains(quiet, "no output on stderr"), "and says so when there is no reason given");
  # Arguments arrive as written, spaces and all, because there is no
  # shell between the list and the program.
  assert(sh["lines"](shell, ["-c", "printf '%s\n' \"$0\" \"$1\"", "a b", "c"]) == ["a b", "c"],
  "argv is not re-split by anyone");

  # A child that a signal killed has no exit code at all. Which
  # signals a platform has is not this suite's business, so the two
  # checks are written to be true on every one of them: either the
  # code is there, or it is nil and the signal names why.
  let killed = run(shell, ["-c", "kill -9 $$"]);
  assert(has(killed, "signal"), "every finished child says whether a signal ended it");
  assert(killed["code"] == nil || killed["code"] != 0, "a killed child does not look happy");
  assert(killed["code"] != nil || killed["signal"] == 9, "and where signals exist it names one");
  assert(run(shell, ["-c", "exit 0"])["signal"] == nil, "a child that exits has no signal");

  # The message a caller sees. "exited nil" was wrong twice over: it
  # did not exit, and nil is not a status.
  let killmsg = err(fn() { return sh["check"](shell, ["-c", "kill -9 $$"]); });
  assert(!contains(killmsg, "nil"), "no failure reports a nil status");
  assert(contains(killmsg, "killed"), "a killed child is reported as killed");
  assert(sh["ended"]({"code": 4, "signal": nil}) == "exited 4", "a code is an exit");
  assert(sh["ended"]({"code": nil, "signal": 9}) == "was killed by signal 9", "a signal is a kill");
  assert(sh["ended"]({"code": nil, "signal": nil}) == "was killed",
  "and a kill with no number is still a kill");

  # Something on the child's stdin — the half of the boundary that
  # was missing. Output has always come back; now data can go in
  # without a temp file or a string quoted into `sh -c`.
  assert(sh["check"](shell, ["-c", "cat"], "hello") == "hello", "a child reads what it is given");
  assert(sh["lines"](shell, ["-c", "sort"], "c\na\nb\n") == ["a", "b", "c"],
  "and the wrappers pass it through");
  assert(sh["ok"](shell, ["-c", "read x; test \"$x\" = go"], "go\n"),
  "ok takes input too");
  assert(sh["check"](shell, ["-c", "cat"]) == "", "no input is an immediate EOF");
  assert(sh["check"](shell, ["-c", "cat"], nil) == "", "and nil says the same thing");
  assert(run(shell, ["-c", "head -c 2"], "abcdef")["out"] == "ab",
  "a child that stops reading early is not an error");
}
