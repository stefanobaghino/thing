# ting testing ting: assignments that name their target once.

let i = 7;
i += 3;
assert(i == 10, "plus");
i -= 2;
assert(i == 8, "minus");
i *= 4;
assert(i == 32, "times");
i /= 3;
assert(i == 10, "divide, truncating like /");
i %= 4;
assert(i == 2, "remainder");

# The operator is the binary one, so it works on whatever that does.
let s = "a";
s += "b";
assert(s == "ab", "strings concatenate");
let f = 1.5;
f *= 2.0;
assert(f == 3.0, "floats stay floats");

# The right-hand side is a whole expression, not one operand.
let n = 2;
n *= 3 + 4;
assert(n == 14, "the whole right-hand side first");

# Into a list slot, negative indices included.
let xs = [1, 2, 3];
xs[0] += 10;
xs[-1] *= 2;
assert(xs == [11, 2, 6], "list slots");

# Into a map key.
let m = {"n": 1};
m["n"] += 41;
assert(m["n"] == 42, "map keys");

# The base and the subscript are evaluated once, so a call in either
# happens once — which is what `m[k()] = m[k()] + 1` cannot promise.
let calls = 0;
fn key() {
  calls += 1;
  return "n";
}
let c = {"n": 0};
c[key()] += 1;
assert(calls == 1 && c["n"] == 1, "the subscript runs once");

# A closure's captured variable is the one that changes.
fn counter() {
  let seen = 0;
  return fn() {
    seen += 1;
    return seen;
  };
}
let next = counter();
assert(next() == 1 && next() == 2 && next() == 3, "captured and updated");

# Reading comes first, so a missing name fails the way `=` does. That
# needs a genuinely unbound name, which --check reports on sight, so
# it is checked from Rust and in the differential corpus instead.

# A missing key is a read error, not a silent zero.
let absent = try(fn() {
  let empty = {};
  empty["k"] += 1;
});
assert(contains(absent["err"], "not found"), "no key, no update");

# The operator still refuses what it always refused.
let mixed = try(fn() {
  let t = "a";
  t -= 1;
});
assert(contains(mixed["err"], "cannot apply '-' to string and int"), "types still checked");

# `xs += [x]` extends the list in place when nothing else holds it, so
# a loop that grows a list costs the appends and not the squares. What
# must not change is what anyone else can see: every other holder of
# the list keeps the list it was given.
let plain = [1];
let same = plain;
plain += [2];
assert(len(plain) == 2 && len(same) == 1, "a second name keeps its own");

let nested = [1];
let inside = [nested];
nested += [2];
assert(len(nested) == 2 && len(inside[0]) == 1, "a list inside a list keeps its own");

let valued = [1];
let held = {"k": valued};
valued += [2];
assert(len(valued) == 2 && len(held["k"]) == 1, "a list in a map keeps its own");

fn capture(x) { return fn() { return x; }; }
let closed = [1];
let reader = capture(closed);
closed += [2];
assert(len(closed) == 2 && len(reader()) == 1, "a closure keeps what it captured");

# Snapshots taken round a loop stay snapshots: each push makes the
# list shared, so the next append copies rather than extends.
let grown = [];
let snaps = [];
for i in range(0, 3) {
  grown += [i];
  push(snaps, grown);
}
assert(len(snaps[0]) == 1 && len(snaps[1]) == 2 && len(snaps[2]) == 3, "each snapshot its own length");

# Growing a list a thousand times is not a thousand copies, but the
# answer is the same either way.
let big = [];
for i in range(0, 1000) { big += [i]; }
assert(len(big) == 1000 && big[0] == 0 && big[999] == 999, "a thousand appends");

# The long spelling takes the same path when the right-hand side
# cannot reach the name, so `xs = xs + [x]` costs what `xs += [x]`
# costs -- and everyone else still keeps the list they were given.
let slow = [1];
let kept = slow;
slow = slow + [2];
assert(len(slow) == 2 && len(kept) == 1, "the long form shares nothing new");

let text = "a";
let copy = text;
text = text + "b";
assert(text == "ab" && copy == "a", "nor does it for strings");

# What the fusing must not swallow: the read is still a read, so its
# errors are the read's, and prepending is not appending.
let front = [1];
front = [0] + front;
assert(front[0] == 0 && len(front) == 2, "prepending still builds a new list");

let wrong = try(fn() {
  let one = "a";
  one = one + 1;
});
assert(contains(wrong["err"], "cannot apply '+' to string and int"), "types still checked");

# A call on the right is fine when the name lives in a frame slot: no
# closure mentions it, so nothing the call does can reach it. What the
# call itself does must still be exactly what it always did. (A script
# that rebinds a builtin is checked in tests/differential.rs, where the
# shadowing does not join the corpus's counted warnings.)
fn captured_stays_shared() {
  let s = "a";
  let read = fn() { return s; };
  s += "b";
  return [s, read()];
}
let pair = captured_stays_shared();
assert(pair[0] == "ab" && pair[1] == "ab", "a captured name is one binding, not two");

fn failing_call() {
  let s = "a";
  let err = try(fn() { s += str(fail("no")); })["err"];
  return err + "/" + s;
}
assert(failing_call() == "no/a", "a call that fails leaves the binding alone");

fn accumulate(n) {
  let acc = [];
  if n > 0 { acc = acc + accumulate(n - 1); }
  acc += [n];
  return acc;
}
assert(join(map(accumulate(3), str), "") == "0123", "each call has its own");

# Two names for the same text now hold the same buffer, so appending
# to one has to copy before it writes. Every way of taking a second
# reference has to be covered, not just a plain binding.
let base = "ab";
let held = [base, base];
let inside = {"k": base};
let by_call = fn(s) { s += "!"; return s; };
assert(by_call(base) == "ab!" && base == "ab", "a parameter is a copy");
base += "c";
assert(base == "abc", "the name itself grew");
assert(held[0] == "ab" && held[1] == "ab", "the list kept the old text");
assert(inside["k"] == "ab", "so did the map");
let taken = held[0];
taken += "z";
assert(held[0] == "ab" && taken == "abz", "reading out of a list copies too");
let doubled = "xy";
doubled = doubled + doubled;
assert(doubled == "xyxy", "a name on both sides is not appended to itself");

# When a function names the target, a call on the right could reassign
# it, so the old value is read before the call runs and the binding is
# only released afterwards if it still holds what was read. Every way
# the call can interfere has to still work.
let target = "a";
let clobber = fn() { target = "other"; return "!"; };
target += clobber();
assert(target == "a!", "the value read before the call is the one added to");
let long_form = "a";
let clobber_long = fn() { long_form = "other"; return "!"; };
long_form = long_form + clobber_long();
assert(long_form == "a!", "and the long spelling does the same");
let stashed = [];
let source = "a";
let stash = fn() { push(stashed, source); return "!"; };
source += stash();
assert(source == "a!" && stashed == ["a"], "what the call kept is not what grew");
let reader = "ab";
let read_it = fn() { return str(len(reader)); };
reader += read_it();
assert(reader == "ab2", "a call that only reads sees the value before the add");
let nested = "a";
let appender = fn() { nested += "X"; return "!"; };
nested += appender();
assert(nested == "a!", "an append from inside the call is overwritten by this one");
let grown = [1];
let regrow = fn() { grown = [9]; return [2]; };
grown += regrow();
assert(grown == [1, 2], "lists take the same path");

# A let can take a list apart where a name goes: exact length, nesting,
# and `_` for a value the program does not want.
let [first, second] = [1, 2];
assert(first == 1 && second == 2, "a pair comes apart");
let [outer, [inner_a, inner_b]] = ["x", [1, 2]];
assert(outer == "x" && inner_a == 1 && inner_b == 2, "and patterns nest");
let [_, kept] = ["dropped", "kept"];
assert(kept == "kept", "a hole matches and keeps nothing");
let [] = [];
let [only] = [[1, 2]];
assert(only == [1, 2], "an element can be a list without being taken apart");
fn sum_pair(p) {
  let [a, b] = p;
  return a + b;
}
assert(sum_pair([3, 4]) == 7, "inside a function too");
fn closes_over(p) {
  let [a, b] = p;
  let f = fn() { return a * b; };
  return f();
}
assert(closes_over([3, 4]) == 12, "and a closure sees what the pattern bound");
let errmsg2 = import("lib/err.ting")["message"];
assert(errmsg2(fn() { let [a, b] = [1, 2, 3]; return a + b; })
== "this pattern takes 2 values, and the list has 3", "too many values is a mistake, not a trim");
assert(errmsg2(fn() { let [a] = []; return a; })
== "this pattern takes 1 value, and the list has 0", "and so is too few");
assert(errmsg2(fn() { let [a, _b] = 5; return a; })
== "this pattern takes a list apart, and the value is int", "a pattern needs a list");
assert(errmsg2(fn() { let [a, _b] = "ab"; return a; })
== "this pattern takes a list apart, and the value is string", "a string is not a list here");

# A for loop takes each element apart the same way, which is what
# walking a map's items is for.
let pairs = [["a", 1], ["b", 2]];
let seen = [];
for [k, v] in pairs { push(seen, k + str(v)); }
assert(seen == ["a1", "b2"], "a loop takes each pair apart");
let nested = [];
for [i, [lo, hi]] in [[0, [1, 2]], [1, [3, 4]]] { push(nested, i + lo + hi); }
assert(nested == [3, 8], "and nests the way a let does");
let total = 0;
for [_, n] in pairs { total += n; }
assert(total == 3, "a hole works in a loop too");
let stopped = [];
for [x, y] in [[1, 2], [3, 4]] {
  if x == 3 { break; }
  push(stopped, y);
}
assert(stopped == [2], "break and continue still see the body they belong to");
assert(errmsg2(fn() { for [a, b] in [[1, 2, 3]] { print(a, b); } })
== "this pattern takes 2 values, and the list has 3", "a loop reports the mismatch the let would");
assert(errmsg2(fn() { for [a, b] in [7] { print(a, b); } })
== "this pattern takes a list apart, and the value is int", "and the wrong type as well");

# A parameter takes its argument apart, which is what makes a
# higher-order call read: fn([k, v]) rather than a let per body.
fn joined([k, v]) { return k + str(v); }
assert(joined(["a", 1]) == "a1", "a parameter takes a pair apart");
assert(map([["a", 1], ["b", 2]], joined) == ["a1", "b2"], "which is the point of it");
fn mixed([a, b], c = 10) { return a + b + c; }
assert(mixed([1, 2]) == 13, "a pattern sits beside a default");
assert(mixed([1, 2], 3) == 6, "and the default is still a default");
fn deep([a, [b, c]]) { return a + b + c; }
assert(deep([1, [2, 3]]) == 6, "patterns nest in a parameter too");
fn dropped([_, x]) { return x; }
assert(dropped([1, 9]) == 9, "and a hole drops what it names nothing");
fn captures([a, b]) { return fn() { return a * b; }; }
assert(captures([3, 4])() == 12, "a closure sees what the parameter bound");
assert(errmsg2(fn() { let f = fn([a, b]) { return a + b; }; return f([1, 2, 3]); })
== "this pattern takes 2 values, and the list has 3", "a mismatched argument reports what a let would");
assert(errmsg2(fn() { let f = fn([a, _b]) { return a; }; return f(7); })
== "this pattern takes a list apart, and the value is int", "and the wrong type as well");

# A map pattern asks for the fields it wants, written the way a map
# literal is: a bare name is its own key, a quoted key nests.
let rec = {"code": 0, "out": "hi", "err": ""};
let {code, out} = rec;
assert(code == 0 && out == "hi", "a bare name is the key of that name");
let {"code": status} = rec;
assert(status == 0, "a quoted key binds whatever name follows it");
let {"out": [first, second]} = {"out": [7, 8]};
assert(first == 7 && second == 8, "and a list pattern nests inside it");
let {"a": {"b": deep2}} = {"a": {"b": 3}};
assert(deep2 == 3, "maps nest in maps");
let {} = {"anything": 1};
assert(true, "an empty map pattern asks for nothing and is happy");
let {"x": _} = {"x": 9};
assert(true, "a hole matches a field and drops it");
assert(errmsg2(fn() { let {nope} = {"a": 1}; return nope; })
== "this pattern asks for the key \"nope\", and the map has no such key",
"a key the map lacks is a mistake");
assert(errmsg2(fn() { let {a} = [1, 2]; return a; })
== "this pattern takes a map apart, and the value is list",
"a list is not a map here");
assert(errmsg2(fn() { let {a} = 5; return a; })
== "this pattern takes a map apart, and the value is int",
"and neither is an int");
let big = {"a": 1, "b": 2, "c": 3};
let {b} = big;
assert(b == 2, "EXTRA KEYS ARE FINE: a map's keys are its contents, not its shape");
