# ting testing ting's own standard library.

let l = import("../lib/list.ting");
assert(l["sum"]([1, 2, 3, 4]) == 10, "sum");
assert(l["sum"]([]) == 0, "sum of empty");
assert(l["reverse"]([1, 2, 3]) == [3, 2, 1], "reverse");
assert(l["zip"]([1, 2, 3], ["a", "b"]) == [[1, "a"], [2, "b"]], "zip trims");
assert(l["enumerate"](["x", "y"]) == [[0, "x"], [1, "y"]], "enumerate");
assert(l["unique"]([1, 2, 1, 3, 2]) == [1, 2, 3], "unique");
assert(l["flatten"]([[1, 2], 3, [4]]) == [1, 2, 3, 4], "flatten");

let s = import("../lib/string.ting");
assert(s["repeat"]("ab", 3) == "ababab", "repeat");
assert(s["repeat"]("x", 0) == "", "repeat zero");
assert(s["pad_left"]("7", 3, "0") == "007", "pad_left");
assert(s["pad_right"]("7", 3, " ") == "7  ", "pad_right");
assert(s["lines"]("a\nb\nc") == ["a", "b", "c"], "lines");
assert(s["title"]("héllo wide  world") == "Héllo Wide  World", "title");

let m = import("../lib/map.ting");
assert(m["get"]({"a": 1}, "a", 0) == 1, "get hit");
assert(m["get"]({"a": 1}, "z", 0) == 0, "get default");
assert(m["merge"]({"a": 1, "b": 2}, {"b": 9, "c": 3}) == {"a": 1, "b": 9, "c": 3}, "merge right wins");
assert(m["items"]({"b": 2, "a": 1}) == [["a", 1], ["b", 2]], "items sorted");
assert(m["from_items"]([["x", 1], ["y", 2]]) == {"x": 1, "y": 2}, "from_items");
assert(m["from_items"](m["items"]({"k": nil})) == {"k": nil}, "round trip");

let ma = import("../lib/math.ting");
assert(ma["clamp"](5, 0, 3) == 3, "clamp high");
assert(ma["clamp"](-1, 0, 3) == 0, "clamp low");
assert(ma["clamp"](2, 0, 3) == 2, "clamp inside");
assert(ma["sign"](-9) == -1 && ma["sign"](0) == 0 && ma["sign"](4) == 1, "sign");
assert(ma["pow"](2, 10) == 1024, "pow");
assert(ma["pow"](7, 0) == 1, "pow zero exponent");
assert(has(try(fn() { return ma["pow"](2, -1); }), "err"), "pow rejects negative");
assert(ma["gcd"](54, 24) == 6, "gcd");
assert(ma["gcd"](-4, 6) == 2, "gcd abs");
assert(ma["gcd"](0, 5) == 5, "gcd zero");
assert(ma["round"](2.5) == 3, "round half up");
assert(ma["round"](-2.5) == -3, "round half away from zero");
assert(ma["round"](2.4) == 2, "round down");
assert(abs(ma["sqrt"](2) - 1.4142135623730951) < 0.0000000001, "sqrt 2");
assert(ma["sqrt"](0) == 0.0, "sqrt zero");
assert(ma["sqrt"](144) == 12.0, "sqrt exact");
assert(has(try(fn() { return ma["sqrt"](-1); }), "err"), "sqrt rejects negative");

assert(l["any"]([1, 2, 3], fn(x) { return x > 2; }), "any hit");
assert(!l["any"]([], fn(x) { return true; }), "any empty is false");
assert(l["all"]([2, 4], fn(x) { return x % 2 == 0; }), "all hit");
assert(!l["all"]([2, 3], fn(x) { return x % 2 == 0; }), "all miss");
assert(l["all"]([], fn(x) { return false; }), "all empty is true");
assert(l["min_by"](["aaa", "b", "cc"], fn(s) { return len(s); }) == "b", "min_by");
assert(l["max_by"](["aaa", "b", "cc"], fn(s) { return len(s); }) == "aaa", "max_by");
assert(l["min_by"]([], fn(x) { return x; }) == nil, "min_by empty is nil");
