# ting testing ting: delimited text, both directions.

let csv = import("lib/csv.ting");

# The plain case, with and without a trailing line break.
assert(csv["parse"]("a,b\n1,2\n") == [["a", "b"], ["1", "2"]], "rows and fields");
assert(csv["parse"]("a,b\n1,2") == [["a", "b"], ["1", "2"]], "a last line need not end");
assert(csv["parse"]("") == [], "no text, no rows");
assert(csv["parse"]("a,,\n") == [["a", "", ""]], "empty fields are fields");
assert(csv["parse"]("\n") == [[""]], "an empty line is a row of one empty field");

# Quoting: separators, quotes and line breaks inside a field.
assert(csv["parse"]("\"Smith, J\",x\n") == [["Smith, J", "x"]], "a comma inside quotes");
assert(csv["parse"]("\"said \"\"hi\"\"\"\n") == [["said \"hi\""]], "a doubled quote is one quote");
assert(csv["parse"]("a,\"two\nlines\"\n") == [["a", "two\nlines"]], "a line break inside quotes");

# CRLF is read, and not written back.
assert(csv["parse"]("a,b\r\nc,d\r\n") == [["a", "b"], ["c", "d"]], "CRLF reads as a line break");
assert(!contains(csv["text"]([["a"]]), "\r"), "and is not written back");

# Writing quotes only what needs it, spaces included.
assert(csv["text"]([["a", "b,c"]]) == "a,\"b,c\"\n", "a separator forces quotes");
assert(csv["text"]([["d\"e"]]) == "\"d\"\"e\"\n", "so does a quote, doubled");
assert(csv["text"]([[" f "]]) == "\" f \"\n", "a space at either end survives");
assert(csv["text"]([["plain"]]) == "plain\n", "and nothing else is quoted");
assert(csv["text"]([]) == "", "no rows, no text");
assert(csv["text"]([[1, 2.5, nil]]) == "1,2.5,nil\n", "fields are written as strings");

# The round trip, which is the property the two halves owe each other.
let hard = [["x", "a,b"], ["say \"hi\"", "two\nlines"], ["", " padded "]];
assert(csv["parse"](csv["text"](hard)) == hard, "text and parse are inverses");

# Another separator, and a header read as names.
assert(csv["parse_with"]("a\tb\n", "\t") == [["a", "b"]], "tabs work as well as commas");
assert(csv["text_with"]([["a", "b"]], ";") == "a;b\n", "and on the way out");
let records = csv["maps"](csv["parse"]("id,name\n1,ann\n2\n"));
assert(len(records) == 2, "one map per row after the header");
assert(records[0]["name"] == "ann", "columns take their names from the header");
assert(records[1]["name"] == nil, "a short row leaves the rest nil");
assert(csv["maps"]([]) == [], "no rows, no records");
assert(csv["maps"]([["only", "header"]]) == [], "a header alone is no records");

# A field past the end of the header has no name. It is dropped, so
# that every entry carries the same keys and a column can be asked
# for without checking first; `extras` names a key to keep it under
# when the caller would rather have it.
let wide = csv["parse"]("a,b,c\n1,2,3,4,5\n6,7,8\n");
let dropped = csv["maps"](wide);
assert(len(keys(dropped[0])) == 3, "the extras are dropped by default");
assert(dropped[0] == {"a": "1", "b": "2", "c": "3"}, "and the named columns are untouched");
let kept = csv["maps"](wide, "rest");
assert(kept[0]["rest"] == ["4", "5"], "extras arrive in order under the named key");
assert(kept[1]["rest"] == [], "a row with none gets an empty list, not a missing key");
assert(keys(kept[0]) == keys(kept[1]), "so every entry still has the same keys");
assert(csv["maps"](csv["parse"]("a,b,c\n1,2\n"), "rest")[0]["rest"] == [],
"a short row has no extras either");

# The trailing separator every spreadsheet writes is one empty extra
# field, which is why dropping is the default and an error is not.
assert(csv["maps"](csv["parse"]("a,b,c\n1,2,3,\n"))[0] == {"a": "1", "b": "2", "c": "3"},
"a trailing separator reads as the three named columns");
assert(csv["maps"](csv["parse"]("a,b,c\n1,2,3,\n"), "rest")[0]["rest"] == [""],
"and the empty field is there for anyone who asks");

# A key that is already a column would hide that column, and a key
# that is not a string cannot be a key at all.
let errmsg = import("lib/err.ting")["message"];
assert(contains(errmsg(fn() { return csv["maps"](wide, "b"); }),
"extras key b is already a column"), "an extras key may not name a column");
assert(contains(errmsg(fn() { return csv["maps"](wide, 3); }),
"extras must be a string, got int"), "and it must be a string");

# A row is not a line. The scanner that reads a whole string and the
# one that reads a file a line at a time are the same scanner, so the
# two must agree on every input — including a field with a line break
# in it, which is where cutting on newlines goes wrong.
let doc = "id,note\n1,\"a note\nwith a newline\"\n2,plain\n";
# A name of its own, because this file is run twice over in one
# process (once per engine, for the coverage comparison) while another
# test is running it in parallel: a fixed name would have the two
# runs writing each other's fixture out from under them. The seed is
# the clock in nanoseconds, so two interpreters do not share one.
let path = format("selftest-csv-rows-{}.csv", random_int(0, 1000000000));
write_file(path, doc);
let streamed = [];
let n = csv["each_row"](path, fn(row) { push(streamed, row); return nil; });
assert(n == 3, "three rows, though the file has four lines");
assert(each_line(path, fn(_l) { return nil; }) == 4, "and it really does have four lines");
assert(streamed == csv["parse"](doc), "streaming and parsing agree");
assert(streamed[1][1] == "a note\nwith a newline", "the line break survived inside the field");

let first = [];
assert(csv["each_row"](path, fn(row) { push(first, row); return false; }) == 1, "false stops the read");
assert(first == [["id", "note"]], "after the first row");

# A file that ends inside an open quote is malformed, and the two
# readers have to be wrong in the same way rather than differently.
let broken = "a,b\n1,\"unfinished\n";
write_file(path, broken);
let ragged = [];
csv["each_row"](path, fn(row) { push(ragged, row); return nil; });
assert(ragged == csv["parse"](broken), "malformed text reads the same either way");
remove_file(path);

# each_map is maps() over a file, and the same file read either way
# has to name its rows identically — the header handling lives in one
# place (entry_of) for exactly this reason.
write_file(path, doc);
let named = [];
let rows = csv["each_map"](path, fn(row) { push(named, row); return nil; });
assert(rows == 2, "two records, the header not being one of them");
assert(named == csv["maps"](csv["parse"](doc)), "streamed maps and parsed maps agree");
assert(named[0]["note"] == "a note\nwith a newline", "a column asked for by name");

# A short row leaves its missing columns nil rather than absent, which
# is what maps does and what a caller can test with == nil.
let ragged_doc = "a,b,c\n1,2\n";
write_file(path, ragged_doc);
let short = [];
csv["each_map"](path, fn(row) { push(short, row); return nil; });
assert(short == csv["maps"](csv["parse"](ragged_doc)), "a short row is short the same way");
assert(short[0]["c"] == nil, "the missing column is nil");
assert(len(keys(short[0])) == 3, "and it is there to be asked for");

# The streaming reader is the one that needs extras most: it never
# sees the whole file, so it cannot be checked afterwards. It names
# them exactly as maps does, on the same file.
let wide_doc = "a,b,c\n1,2,3,4\n";
write_file(path, wide_doc);
let streamed = [];
csv["each_map"](path, fn(row) { push(streamed, row); return nil; }, ",", "rest");
assert(streamed == csv["maps"](csv["parse"](wide_doc), "rest"),
"streamed extras and parsed extras agree");
assert(streamed[0]["rest"] == ["4"], "and the field past the header is kept");

# Stopping, and the two files that have nothing to hand over.
write_file(path, doc);
let one = [];
assert(csv["each_map"](path, fn(row) { push(one, row); return false; }) == 1,
"false stops the read after the record it was given");
assert(len(one) == 1 && one[0]["id"] == "1", "which is the first record, not the header");
write_file(path, "just,a,header\n");
assert(csv["each_map"](path, fn(_row) { return nil; }) == 0, "a header alone is no records");
write_file(path, "");
assert(csv["each_map"](path, fn(_row) { return nil; }) == 0, "and an empty file is none either");
remove_file(path);

# A spreadsheet writes a byte order mark at the head of the file it
# exports. Behind one, a column asked for by name is not found — so
# the scanner drops it, in the one place both readers share.
let bom = chr(65279);
assert(csv["parse"](bom + "a,b\n1,2\n")[0] == ["a", "b"], "a leading byte order mark is not a name");
write_file(path, bom + "date,amount\n2026-01-05,10.50\n");
let excel = [];
csv["each_map"](path, fn(row) { push(excel, row); return nil; });
assert(has(excel[0], "date"), "and the streamed reader drops the same one");
assert(excel == csv["maps"](csv["parse"](read_file(path))), "both readers agree, mark and all");
# Only at the head. Elsewhere it is a character in a field, and a
# second one is too.
assert(csv["parse"](bom + bom + "a\n")[0] == [bom + "a"], "only the first is a mark");
assert(csv["parse"]("a," + bom + "b\n")[0][1] == bom + "b", "and only at the start of the file");
remove_file(path);
