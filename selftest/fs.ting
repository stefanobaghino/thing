# ting testing ting: the fs module's path handling.

let fs = import("../lib/fs.ting");

assert(fs["base"]("a/b/c.ting") == "c.ting", "base takes the last piece");
assert(fs["base"]("c") == "c", "base of a bare name");
assert(fs["base"]("") == "", "base of nothing");
assert(fs["base"]("a\\b\\c.ting") == "c.ting", "backslashes split too");

assert(fs["dir"]("a/b/c") == "a/b", "dir drops the last piece");
assert(fs["dir"]("c") == ".", "dir of a bare name is here");
assert(fs["dir"]("/a/b") == "/a", "an absolute path keeps its root");
assert(fs["dir"]("/a") == "/", "the root itself");

assert(fs["ext"]("a/b.ting") == "ting", "ext without the dot");
assert(fs["ext"]("noext") == "", "no dot, no extension");
assert(fs["ext"](".bashrc") == "", "a leading dot is not an extension");
assert(fs["ext"]("a.b.c") == "c", "the last dot wins");

assert(fs["stem"]("a/b.ting") == "b", "stem drops the extension");
assert(fs["stem"](".bashrc") == ".bashrc", "a dotfile is all stem");

assert(fs["parts"]("a//b/") == ["a", "b"], "empty pieces dropped");
assert(fs["join_path"](["a/", "b", "c.ting"]) == "a/b/c.ting", "joined with one slash");
assert(fs["join_path"](["/a", "b"]) == "/a/b", "an absolute first piece stays absolute");
assert(fs["join_path"]([]) == "", "nothing joins to nothing");

assert(fs["with_ext"]("a/b.ting", "md") == "a/b.md", "extension replaced");
assert(fs["with_ext"]("b.ting", "md") == "b.md", "no directory added");
assert(fs["with_ext"]("a/b.ting", "") == "a/b", "an empty extension removes it");

# A tree this file builds, walks, and removes. It can tidy up after
# itself now that remove_file and remove_dir exist, which is why this
# lives here rather than only in the Rust tests.
let root = "selftest-fs-tree";
fs["remove_tree"](root);
make_dir(root + "/deep/deeper");
write_file(root + "/a.ting", "");
write_file(root + "/b.txt", "");
write_file(root + "/deep/c.ting", "");
write_file(root + "/deep/deeper/d.ting", "");

assert(list_dir(root) == ["a.ting", "b.txt", "deep"], "names, sorted");
assert(fs["entries"](root)[0] == root + "/a.ting", "entries are paths");
assert(exists(root + "/a.ting"), "the file is there");
assert(is_dir(root + "/deep"), "the directory is a directory");
assert(!exists(root + "/nope"), "and what is not there is not");

let found = fs["walk"](root);
assert(len(found) == 4, "every file, no directories");
assert(found[0] == root + "/a.ting", "sorted, files before subdirectories");
assert(contains(found, root + "/deep/deeper/d.ting"), "the deepest one too");
assert(len(fs["walk_ext"](root, "ting")) == 3, "only the ting files");
assert(fs["walk"](root + "/a.ting") == [root + "/a.ting"], "a file walks to itself");

# What a file is, besides its name. len(read_file(p)) counts
# characters and refuses a file that is not text; stat counts bytes
# and never opens it.
write_file(root + "/bytes.txt", "héllo");
let facts = stat(root + "/bytes.txt");
assert(facts["size"] == 6, "size is bytes");
assert(len(read_file(root + "/bytes.txt")) == 5, "which is not what len says");
assert(facts["kind"] == "file", "and it says what kind of thing the path names");
assert(stat(root + "/deep")["kind"] == "dir", "a directory says so");
assert(stat(root + "/nope") == nil, "nothing there is nil, not an error");
let age = time_ms() - facts["modified"];
assert(age >= -1000 && age < 60000, "modified is the clock time_ms reads");
assert(try(stat, 3)["err"] == "stat expects a string path, got int", "a path is a string");

# And the module on top of it: a size without the map, every file's
# facts in one pass, and the total.
assert(fs["size"](root + "/bytes.txt") == 6, "size is stat's size");
assert(fs["size"](root + "/nope") == nil, "and nil where stat is nil");
let rows = fs["facts"](root);
assert(len(rows) == 5, "one row per file, directories left out");
assert(rows[0]["path"] == root + "/a.ting", "sorted by path, like walk");
assert(keys(rows[0]) == ["kind", "modified", "path", "size"], "path plus what stat says");
assert(fs["total_size"](root) == 6, "only bytes.txt has any bytes in it");
remove_file(root + "/bytes.txt");
assert(fs["total_size"](root) == 0, "and now none of them do");

# Renaming: the move that gives a file another name without copying
# it. The modification time is the tell — a.ting was written at the
# top of this file and its stamp has to survive the move, where
# write_file(t, read_file(s)) would stamp the copy now.
let stamped = stat(root + "/a.ting")["modified"];
rename(root + "/a.ting", root + "/renamed.ting");
assert(!exists(root + "/a.ting"), "the old name is gone");
assert(stat(root + "/renamed.ting")["modified"] == stamped, "and the date came with it");
rename(root + "/renamed.ting", root + "/a.ting");
write_file(root + "/over.txt", "new");
write_file(root + "/under.txt", "old");
rename(root + "/over.txt", root + "/under.txt");
assert(read_file(root + "/under.txt") == "new", "an existing target is replaced, silently");
assert(!exists(root + "/over.txt"), "leaving one file where there were two");
remove_file(root + "/under.txt");
make_dir(root + "/box/inner");
rename(root + "/box", root + "/crate");
assert(is_dir(root + "/crate/inner"), "a directory moves whole, and cheaply");
fs["remove_tree"](root + "/crate");
assert(try(rename, root + "/nope", root + "/x")["err"] != nil, "renaming nothing errors");
assert(try(rename, 1, "x")["err"] == "rename expects two string paths, got int and string",
"both paths are strings");

# Copying: the move rename cannot make — across a filesystem, or of a
# file read_file would refuse. The date follows the bytes, the way it
# does when mv has to fall back to copying. b.txt was written at the
# top of this file, so an equal stamp here is not two operations
# landing in one millisecond.
let stamp = stat(root + "/b.txt")["modified"];
copy_file(root + "/b.txt", root + "/copy.txt");
assert(stat(root + "/copy.txt")["modified"] == stamp, "the copy carries the original's date");
assert(exists(root + "/b.txt"), "and the original stays, unlike rename");
write_file(root + "/source.txt", "hello");
copy_file(root + "/source.txt", root + "/copy.txt");
assert(read_file(root + "/copy.txt") == "hello", "an existing target is overwritten");
assert(try(copy_file, root + "/source.txt", root + "/source.txt")["err"] != nil,
"copying a file onto itself errors");
assert(read_file(root + "/source.txt") == "hello",
"rather than emptying it, which is what the copy underneath would do");
assert(try(copy_file, root, root + "/x")["err"] != nil, "a directory is not a file to copy");
assert(try(copy_file, "x")["err"] != nil, "and it takes two paths, not one");
remove_file(root + "/source.txt");
remove_file(root + "/copy.txt");

# And the move on top of the two of them: a rename where that works,
# and what mv does where it does not. Both paths here are on one
# filesystem, so this is the rename, date and all.
write_file(root + "/here.txt", "cargo");
let carried = stat(root + "/b.txt")["modified"];
fs["move"](root + "/b.txt", root + "/there.txt");
assert(!exists(root + "/b.txt"), "the file left the old name");
assert(stat(root + "/there.txt")["modified"] == carried, "with its date");
fs["move"](root + "/here.txt", root + "/there.txt");
assert(read_file(root + "/there.txt") == "cargo", "and a move replaces its target");
fs["move"](root + "/there.txt", root + "/b.txt");
assert(try(fs["move"], root + "/nope", root + "/x")["err"] != nil, "moving nothing errors");

# A file read a line at a time. The lines arrive as input() gives
# them: no newline, and no carriage return before it, so a file
# written on Windows reads like one written here. The last line
# counts even without a newline after it.
write_file(root + "/lines.txt", "one\r\ntwo\nthree");
let seen = [];
assert(each_line(root + "/lines.txt", fn(l) { push(seen, l); return nil; }) == 3,
"it answers how many lines it gave");
assert(seen == ["one", "two", "three"], "newline and carriage return both gone");
let first = nil;
assert(each_line(root + "/lines.txt", fn(l) { first = l; return false; }) == 1,
"false stops the read");
assert(first == "one", "after the first line");
write_file(root + "/none.txt", "");
assert(each_line(root + "/none.txt", fn(_l) { return nil; }) == 0, "an empty file has no lines");
assert(try(each_line, root + "/nope", fn(_l) { return nil; })["err"] != nil,
"a file that is not there errors, as read_file does");
assert(try(each_line, root + "/lines.txt", 3)["err"] ==
"each_line expects a string path and a function, got string and int",
"a path and a function");
remove_file(root + "/lines.txt");
remove_file(root + "/none.txt");

# Removal: a file, then an empty directory, then the whole tree.
remove_file(root + "/b.txt");
assert(!exists(root + "/b.txt"), "the file is gone");
assert(try(remove_dir, root)["err"] != nil, "a full directory is not removable");
assert(try(remove_file, root + "/nope")["err"] != nil, "removing nothing errors");

fs["remove_tree"](root);
assert(!exists(root), "the tree is gone");
fs["remove_tree"](root);
assert(!exists(root), "and removing it again is quiet");
