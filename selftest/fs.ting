# ting testing ting: the fs module's path handling.

let fs = import("../lib/fs.ting");

assert(fs["base"]("a/b/c.ting") == "c.ting", "base takes the last piece");
assert(fs["base"]("c") == "c", "base of a bare name");
assert(fs["base"]("") == "", "base of nothing");
assert(fs["base"]("a\\b\\c.ting") == "c.ting", "backslashes split too");

assert(fs["dir"]("a/b/c") == "a/b", "dir drops the last piece");
assert(fs["dir"]("c") == ".", "dir of a bare name is here");
assert(fs["dir"]("/a/b") == "/a", "an absolute path keeps its root");
assert(fs["dir"]("/a") == "/", "the root itself");

assert(fs["ext"]("a/b.ting") == "ting", "ext without the dot");
assert(fs["ext"]("noext") == "", "no dot, no extension");
assert(fs["ext"](".bashrc") == "", "a leading dot is not an extension");
assert(fs["ext"]("a.b.c") == "c", "the last dot wins");

assert(fs["stem"]("a/b.ting") == "b", "stem drops the extension");
assert(fs["stem"](".bashrc") == ".bashrc", "a dotfile is all stem");

assert(fs["parts"]("a//b/") == ["a", "b"], "empty pieces dropped");
assert(fs["join_path"](["a/", "b", "c.ting"]) == "a/b/c.ting", "joined with one slash");
assert(fs["join_path"](["/a", "b"]) == "/a/b", "an absolute first piece stays absolute");
assert(fs["join_path"]([]) == "", "nothing joins to nothing");

assert(fs["with_ext"]("a/b.ting", "md") == "a/b.md", "extension replaced");
assert(fs["with_ext"]("b.ting", "md") == "b.md", "no directory added");
assert(fs["with_ext"]("a/b.ting", "") == "a/b", "an empty extension removes it");

# A tree this file builds, walks, and removes. It can tidy up after
# itself now that remove_file and remove_dir exist, which is why this
# lives here rather than only in the Rust tests.
let root = "selftest-fs-tree";
fs["remove_tree"](root);
make_dir(root + "/deep/deeper");
write_file(root + "/a.ting", "");
write_file(root + "/b.txt", "");
write_file(root + "/deep/c.ting", "");
write_file(root + "/deep/deeper/d.ting", "");

assert(list_dir(root) == ["a.ting", "b.txt", "deep"], "names, sorted");
assert(fs["entries"](root)[0] == root + "/a.ting", "entries are paths");
assert(exists(root + "/a.ting"), "the file is there");
assert(is_dir(root + "/deep"), "the directory is a directory");
assert(!exists(root + "/nope"), "and what is not there is not");

let found = fs["walk"](root);
assert(len(found) == 4, "every file, no directories");
assert(found[0] == root + "/a.ting", "sorted, files before subdirectories");
assert(contains(found, root + "/deep/deeper/d.ting"), "the deepest one too");
assert(len(fs["walk_ext"](root, "ting")) == 3, "only the ting files");
assert(fs["walk"](root + "/a.ting") == [root + "/a.ting"], "a file walks to itself");

# Removal: a file, then an empty directory, then the whole tree.
remove_file(root + "/b.txt");
assert(!exists(root + "/b.txt"), "the file is gone");
assert(try(remove_dir, root)["err"] != nil, "a full directory is not removable");
assert(try(remove_file, root + "/nope")["err"] != nil, "removing nothing errors");

fs["remove_tree"](root);
assert(!exists(root), "the tree is gone");
fs["remove_tree"](root);
assert(!exists(root), "and removing it again is quiet");
