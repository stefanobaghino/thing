# ting testing ting: JSON round trips.

assert(json_parse("null") == nil, "null");
assert(json_parse("[1, 2.5, \"x\", true]") == [1, 2.5, "x", true], "array");
assert(json_parse("{\"a\": {\"b\": [1]}}")["a"]["b"][0] == 1, "nesting");
assert(json_str({"b": 2, "a": [1, nil]}) == "{\"a\":[1,null],\"b\":2}", "encode sorts keys");
assert(json_str("hé\"llo\n") == "\"hé\\\"llo\\n\"", "string escapes");
assert(json_str(2.0) == "2.0", "floats stay floats");

# Full round trip through a realistic document.
let doc = {"name": "ting", "tags": ["tiny", "strict"], "version": 0.8, "wasm": true};
assert(json_parse(json_str(doc)) == doc, "round trip");

# Errors are catchable.
let bad = try(json_parse, "[1,]");
assert(contains(bad["err"], "json_parse"), "malformed input errors");
let fun = try(json_str, len);
assert(contains(fun["err"], "function"), "functions cannot encode");

# Pretty printing: optional indent, round-trips.
let doc2 = {"a": [1, 2], "b": {}};
assert(contains(json_str(doc2, 2), "\n  \"a\": [\n    1,"), "pretty shape");
assert(json_parse(json_str(doc2, 4)) == doc2, "pretty round trip");
assert(json_str(doc2, 0) != json_str(doc2), "indent 0 still multiline");
let badindent = try(json_str, doc2, "x");
assert(contains(badindent["err"], "indent"), "indent type checked");

# Control characters round-trip (\r expressible in source since 2.11).
assert(json_str("a\r\n\tb") == "\"a\\r\\n\\tb\"", "control chars escaped");
assert(json_parse(json_str("a\r\n\tb")) == "a\r\n\tb", "control chars round trip");
assert(json_parse("\"\\u000d\"") == "\r", "unicode escape for CR");

# A document another program wrote may begin with a byte order mark.
# It is not part of the JSON, so it is skipped rather than reported as
# a character no value can start with.
let bom = chr(65279);
assert(json_parse(bom + "{\"a\": 1}") == {"a": 1}, "a leading byte order mark is not content");
assert(json_parse(bom + "[]") == [], "whatever the document holds");
assert(json_parse(bom + " 1") == 1, "and space may follow it");
# Only at the head, and only one: anywhere else it is a character like
# any other, and the error still says where.
assert(json_parse("\"" + bom + "\"") == bom, "inside a string it survives");
let twice = try(json_parse, bom + bom + "1");
assert(contains(twice["err"], "offset 0"), "a second mark is a character, at offset 0");
let after = try(json_parse, "1" + bom);
assert(contains(after["err"], "trailing"), "and one at the end is trailing");
