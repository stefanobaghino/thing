# ting testing ting: string builtins.

assert("foo" + "bar" == "foobar", "concat");
assert(len("héllo") == 5, "len counts chars, not bytes");
assert("héllo"[1] == "é", "indexing by char");
assert("abc"[-1] == "c", "negative index");

assert(join(split("a,b,,c", ","), "|") == "a|b||c", "split keeps empties");
assert(len(split("hé", "")) == 2, "empty separator splits chars");
assert(trim("  hi \t") == "hi", "trim");
assert(contains("haystack", "stack"), "substring");
assert(!contains("haystack", "z"), "no substring");
assert(replace("a-b-c", "-", "+") == "a+b+c", "replace all");
assert(starts_with("ting", "ti") && ends_with("ting", "ng"), "affixes");
assert(upper("héllo") == "HÉLLO" && lower("HÉLLO") == "héllo", "case");

assert(slice("hello", 1, 3) == "el", "slice");
assert(slice("hello", -3, 99) == "llo", "slice clamps and negatives");
assert(slice("hello", 3, 1) == "", "backwards slice is empty");

assert(str(42) == "42", "str of int");
assert(int("  42 ") == 42, "int parses with spaces");
assert(float("1.5") == 1.5, "float parses");
assert(type("x") == "string", "type");

let bad = try(int, "nope");
assert(has(bad, "err"), "unparseable int errors");

# format(): {} placeholders, {{}} escapes, strict counts.
assert(format("{} + {} = {}", 1, 2, 3) == "1 + 2 = 3", "format basics");
assert(format("no placeholders") == "no placeholders", "format passthrough");
assert(format("{{}} literal, {} filled", "x") == "{} literal, x filled", "format escapes");
assert(format("list: {}", [1, "a"]) == "list: [1, \"a\"]", "format renders like print");
let few = try(format, "{} {}", 1);
assert(contains(few["err"], "placeholders"), "too few values errors");
let many = try(format, "{}", 1, 2);
assert(contains(many["err"], "placeholder"), "too many values errors");
let stray = try(format, "oops }");
assert(contains(stray["err"], "stray"), "stray brace errors");
let unclosed = try(format, "{:>4", 1);
assert(contains(unclosed["err"], "unclosed"), "unclosed brace errors");

# format specs: [[fill] align] width. Width counts characters, and a
# value already that wide is left alone.
assert(format("{:>8}", "hi") == "      hi", "right align");
assert(format("{:<8}", "hi") == "hi      ", "left align");
assert(format("{:^9}", "hi") == "   hi    ", "centre, odd character to the right");
assert(format("{:0>2}", 7) == "07", "fill before the alignment");
assert(format("{:.^10}", "mid") == "...mid....", "any character fills");
assert(format("{:2}", "abcdef") == "abcdef", "a wider value is left alone");
# A width spec lines a column up in a terminal, so it counts COLUMNS.
assert(format("{:<4}|", "日") == "日  |", "a width spec counts columns");
assert(format("{:>4}", "é") == "   é", "a combining accent takes no column");
assert(format("{:^6}", "日") == "  日  ", "a centred wide value");
assert(format("{:2}", "日本") == "日本", "a value already that wide is left alone");
assert(format("{:}", 9) == "9", "an empty spec is just the value");
assert(format("{:0}", 9) == "9", "width zero is just the value");
# A zero in front of the width fills with zeroes, past the sign. An
# explicit fill is literal, so {:0>5} keeps writing them at the edge.
assert(format("{:05}", 42) == "00042", "a leading zero fills with zeroes");
assert(format("{:03}", 7) == "007", "and it is the spelling fingers reach for");
assert(format("{:05}", -42) == "-0042", "the zeroes go past the minus sign");
assert(format("{:07.2}", -3.5) == "-003.50", "decimal places too");
assert(format("{:0>5}", -42) == "00-42", "an explicit fill stays literal");
assert(format("{:>05}", -42) == "00-42", "and an alignment says where the zeroes go");
assert(format("{:<05}", -42) == "-4200", "on either side");
assert(format("{:.^05}", 7) == "..7..", "a fill written out keeps the column");
assert(format("{:05}", "ab") == "000ab", "a string is filled at the edge");
assert(format("{:0{}}", 7, 4) == "0007", "the width may still come from the arguments");
assert(format("{:00}", 9) == "9", "a zero fill of width zero is just the value");
# A width with no alignment lays numbers right and everything else left.
assert(format("{:5}", 42) == "   42", "a number goes right");
assert(format("{:5}", 4.5) == "  4.5", "a float goes right too");
assert(format("{:5}", "ab") == "ab   ", "a string goes left");
assert(format("{:5}", true) == "true ", "a bool goes left");
assert(format("{:>4}", "\u00e9\u20ac") == "  \u00e9\u20ac", "width counts characters, not bytes");
assert(format("{{{:>3}}}", 1) == "{  1}", "specs survive escaped braces");
assert(format("{} {:>4} {}", "a", 12, "b") == "a   12 b", "specs mix with plain placeholders");
let bad_spec = try(format, "{x}", 1);
assert(contains(bad_spec["err"], "not a placeholder"), "a spec must start with a colon");
let bad_width = try(format, "{:qq}", 1);
assert(contains(bad_width["err"], "not a width"), "a spec's tail must be a number");
let huge = try(format, "{:>999999999}", 1);
assert(contains(huge["err"], "above the limit"), "widths are capped");

# format specs: decimal places. Halves go AWAY FROM ZERO, the way
# lib/math.ting's round() promises -- Rust's own float formatting
# takes them to even, so this is a deliberate difference.
assert(format("{:.2}", 0.125) == "0.13", "a half rounds away from zero");
assert(format("{:.1}", 0.25) == "0.3", "and again one place up");
assert(format("{:.0}", 2.5) == "3", "no places still rounds away from zero");
assert(format("{:.0}", -2.5) == "-3", "negative halves go away from zero too");
assert(format("{:.2}", 100.0 / 3.0) == "33.33", "a third to two places");
assert(format("{:.3}", 1.5) == "1.500", "places are padded with zeroes");
# An int is written digit for digit, so a value past a float's exact
# range keeps every digit it had.
assert(format("{:.2}", 3) == "3.00", "an int takes decimal places");
assert(format("{:.0}", 7) == "7", "no places leaves an int alone");
assert(format("{:.2}", 9007199254740993) == "9007199254740993.00", "big ints keep every digit");
# Width and places together: the money column this was written for.
assert(format("{:>8.2}", 1234.5) == " 1234.50", "width and places");
assert(format("{:0>8.2}", 3.5) == "00003.50", "fill, width and places");
assert(format("{:8.2}", 1.5) == "    1.50", "a number with places still goes right");
let no_number = try(format, "{:.2}", "text");
assert(contains(no_number["err"], "needs a number"), "places need a number");
let no_places = try(format, "{:>4.}", 1);
assert(contains(no_places["err"], "no number of decimal places"), "a bare dot errors");
let bad_places = try(format, "{:.x}", 1);
assert(contains(bad_places["err"], "not a number of decimal places"), "places must be a number");
let deep = try(format, "{:.200}", 1.5);
assert(contains(deep["err"], "above the limit"), "places are capped");

# format specs: a width or a number of places written `{}` is read
# from the arguments, the value first and then the spec's holes left
# to right. The data decides how wide a column is, so a template that
# cannot ask is a template that sends you back to pad_right.
let w = 7;
assert(format("[{:<{}}]", "ab", w) == "[ab     ]", "a width from the arguments");
assert(format("[{:>{}}]", "ab", w) == "[     ab]", "and right-aligned");
assert(format("[{:{}}]", 42, 6) == "[    42]", "a hole with no alignment");
assert(format("[{:0>{}}]", 7, 4) == "[0007]", "fill, alignment and a hole");
assert(format("[{:.{}}]", 2.5, 0) == "[3]", "places from the arguments");
assert(format("[{:>{}.{}}]", 3.14159, 9, 3) == "[    3.142]", "both from the arguments");
assert(format("{:{}}|{:{}}", "a", 3, "b", 2) == "a  |b ", "two holes, in order");
assert(format("[{:{}}]", "ab", 0) == "[ab]", "a width of zero from the arguments");
let no_width = try(format, "{:<{}}", "ab");
assert(contains(no_width["err"], "takes its width from the next"), "a hole needs an argument");
let no_place = try(format, "{:>{}.{}}", 1.5, 8);
assert(contains(no_place["err"], "number of decimal places from the next"), "so does a places hole");
let text_width = try(format, "{:<{}}", "ab", "x");
assert(contains(text_width["err"], "must be an int"), "a width from the arguments is an int");
let neg_width = try(format, "{:<{}}", "ab", 0 - 1);
assert(contains(neg_width["err"], "cannot be negative"), "and not negative");
let over = try(format, "{:<{}}", "ab", 999999999);
assert(contains(over["err"], "above the limit"), "a width from the arguments is capped too");
let spare = try(format, "{:<{}}", "ab", 7, 9);
assert(contains(spare["err"], "the template takes 2 arguments but 3"), "spare arguments are counted the new way");

# \r escape (added in 2.11): a real carriage return, one char.
assert(len("\r") == 1, "cr is one char");
assert("a\rb" != "a\nb", "cr is not lf");

# Escapes that name a code point, and the two builtins that convert.
assert("\u0041" == "A", "a four-hex escape is that character");
assert(len("\u00e9") == 1, "one character, not two bytes");
assert("\ud83d\ude00" == "😀", "a surrogate pair is one character");
assert(json_parse("\"\\u0041\"") == "\u0041", "a literal and json_parse agree");
assert(ord("A") == 65 && ord("é") == 233, "ord gives the code point");
assert(chr(65) == "A" && chr(128512) == "😀", "chr gives the character");
assert(ord(chr(9731)) == 9731, "the two are inverses");
assert(try(ord, "ab")["err"] != nil, "ord wants one character");
assert(try(chr, -1)["err"] != nil, "chr wants a code point");
assert(try(chr, 55296)["err"] != nil, "a surrogate is not a character");

# Reading a character walks to it rather than decoding the whole
# string, so the paths that count from the start and from the end are
# now different code. Both still answer in characters.
let mixed = "aé漢字z";
assert(mixed[0] == "a" && mixed[2] == "漢" && mixed[-1] == "z", "index from either end");
assert(slice(mixed, 1, 4) == "é漢字", "slice counts characters");
assert(slice(mixed, -2, 99) == "字z", "a slice past the end stops at it");
assert(slice(mixed, 3, 1) == "", "a backwards slice is empty");
assert(slice(mixed, 0, 0) == "" && slice("", 0, 1) == "", "nothing to take");
let far = try(fn() { return mixed[5]; });
assert(contains(far["err"], "index 5 out of bounds (len 5)"), "the length is in characters");

# The character count is remembered, so appending has to keep it
# right rather than let it go stale. Mixing widths is the case that
# catches an update done in bytes.
let grown = "";
let g = 0;
while g < 4 { grown += "aé漢"; g += 1; }
assert(len(grown) == 12, "an appended count stays in characters");
assert(grown[3] == "a" && grown[5] == "漢" && grown[-1] == "漢", "and still indexes right");
assert(slice(grown, 3, 6) == "aé漢", "and still slices right");
let widened = "abc";
assert(len(widened) == 3, "counted while it is all one byte");
widened += "é";
assert(len(widened) == 4 && widened[3] == "é", "and again once it is not");
let narrowed = "é";
assert(len(narrowed) == 1, "counted while it is not");
narrowed += "ab";
assert(len(narrowed) == 3 && narrowed[2] == "b" && slice(narrowed, 1, 3) == "ab", "and again after");

# display_width(): what a terminal counts, where len() counts characters.
assert(display_width("abc") == 3 && display_width("") == 0, "width of plain text is its length");
assert(len("日本") == 2 && display_width("日本") == 4, "an ideograph takes two columns");
assert(display_width("１２") == 4, "and so does a fullwidth digit");
assert(display_width("🙂") == 2, "an emoji takes two");
assert(display_width("é") == 1 && display_width("é") == 1,
  "a combining accent rides on the letter, however the word is spelled");
assert(display_width("a‍b") == 2, "a zero-width joiner takes no column");
assert(display_width("a\tb") == 2, "a control takes none either: what a tab advances to is the terminal's business");
assert(display_width("añ日🙂") == 6, "a mixed string is the sum of its characters");
let errmsg = import("lib/err.ting")["message"];
assert(errmsg(fn() { return display_width(1); }) == "display_width expects a string, got int", "width wants a string");
assert(errmsg(fn() { return display_width(); }) == "display_width expects 1 argument, got 0", "width wants one");
