# ting testing ting: string builtins.

assert("foo" + "bar" == "foobar", "concat");
assert(len("héllo") == 5, "len counts chars, not bytes");
assert("héllo"[1] == "é", "indexing by char");
assert("abc"[-1] == "c", "negative index");

assert(join(split("a,b,,c", ","), "|") == "a|b||c", "split keeps empties");
assert(len(split("hé", "")) == 2, "empty separator splits chars");
assert(trim("  hi \t") == "hi", "trim");
assert(contains("haystack", "stack"), "substring");
assert(!contains("haystack", "z"), "no substring");
assert(replace("a-b-c", "-", "+") == "a+b+c", "replace all");
assert(starts_with("ting", "ti") && ends_with("ting", "ng"), "affixes");
assert(upper("héllo") == "HÉLLO" && lower("HÉLLO") == "héllo", "case");

assert(slice("hello", 1, 3) == "el", "slice");
assert(slice("hello", -3, 99) == "llo", "slice clamps and negatives");
assert(slice("hello", 3, 1) == "", "backwards slice is empty");

assert(str(42) == "42", "str of int");
assert(int("  42 ") == 42, "int parses with spaces");
assert(float("1.5") == 1.5, "float parses");
assert(type("x") == "string", "type");

let bad = try(int, "nope");
assert(has(bad, "err"), "unparseable int errors");

# format(): {} placeholders, {{}} escapes, strict counts.
assert(format("{} + {} = {}", 1, 2, 3) == "1 + 2 = 3", "format basics");
assert(format("no placeholders") == "no placeholders", "format passthrough");
assert(format("{{}} literal, {} filled", "x") == "{} literal, x filled", "format escapes");
assert(format("list: {}", [1, "a"]) == "list: [1, \"a\"]", "format renders like print");
let few = try(format, "{} {}", 1);
assert(contains(few["err"], "placeholders"), "too few values errors");
let many = try(format, "{}", 1, 2);
assert(contains(many["err"], "placeholder"), "too many values errors");
let stray = try(format, "oops }");
assert(contains(stray["err"], "stray"), "stray brace errors");

# \r escape (added in 2.11): a real carriage return, one char.
assert(len("\r") == 1, "cr is one char");
assert("a\rb" != "a\nb", "cr is not lf");

# Escapes that name a code point, and the two builtins that convert.
assert("\u0041" == "A", "a four-hex escape is that character");
assert(len("\u00e9") == 1, "one character, not two bytes");
assert("\ud83d\ude00" == "😀", "a surrogate pair is one character");
assert(json_parse("\"\\u0041\"") == "\u0041", "a literal and json_parse agree");
assert(ord("A") == 65 && ord("é") == 233, "ord gives the code point");
assert(chr(65) == "A" && chr(128512) == "😀", "chr gives the character");
assert(ord(chr(9731)) == 9731, "the two are inverses");
assert(try(ord, "ab")["err"] != nil, "ord wants one character");
assert(try(chr, -1)["err"] != nil, "chr wants a code point");
assert(try(chr, 55296)["err"] != nil, "a surrogate is not a character");

# Reading a character walks to it rather than decoding the whole
# string, so the paths that count from the start and from the end are
# now different code. Both still answer in characters.
let mixed = "aé漢字z";
assert(mixed[0] == "a" && mixed[2] == "漢" && mixed[-1] == "z", "index from either end");
assert(slice(mixed, 1, 4) == "é漢字", "slice counts characters");
assert(slice(mixed, -2, 99) == "字z", "a slice past the end stops at it");
assert(slice(mixed, 3, 1) == "", "a backwards slice is empty");
assert(slice(mixed, 0, 0) == "" && slice("", 0, 1) == "", "nothing to take");
let far = try(fn() { return mixed[5]; });
assert(contains(far["err"], "index 5 out of bounds (len 5)"), "the length is in characters");

# The character count is remembered, so appending has to keep it
# right rather than let it go stale. Mixing widths is the case that
# catches an update done in bytes.
let grown = "";
let g = 0;
while g < 4 { grown += "aé漢"; g += 1; }
assert(len(grown) == 12, "an appended count stays in characters");
assert(grown[3] == "a" && grown[5] == "漢" && grown[-1] == "漢", "and still indexes right");
assert(slice(grown, 3, 6) == "aé漢", "and still slices right");
let widened = "abc";
assert(len(widened) == 3, "counted while it is all one byte");
widened += "é";
assert(len(widened) == 4 && widened[3] == "é", "and again once it is not");
let narrowed = "é";
assert(len(narrowed) == 1, "counted while it is not");
narrowed += "ab";
assert(len(narrowed) == 3 && narrowed[2] == "b" && slice(narrowed, 1, 3) == "ab", "and again after");
