# ting testing ting: string builtins.

assert("foo" + "bar" == "foobar", "concat");
assert(len("héllo") == 5, "len counts chars, not bytes");
assert("héllo"[1] == "é", "indexing by char");
assert("abc"[-1] == "c", "negative index");

assert(join(split("a,b,,c", ","), "|") == "a|b||c", "split keeps empties");
assert(len(split("hé", "")) == 2, "empty separator splits chars");
assert(trim("  hi \t") == "hi", "trim");
assert(contains("haystack", "stack"), "substring");
assert(!contains("haystack", "z"), "no substring");
assert(replace("a-b-c", "-", "+") == "a+b+c", "replace all");
assert(starts_with("ting", "ti") && ends_with("ting", "ng"), "affixes");
assert(upper("héllo") == "HÉLLO" && lower("HÉLLO") == "héllo", "case");

assert(slice("hello", 1, 3) == "el", "slice");
assert(slice("hello", -3, 99) == "llo", "slice clamps and negatives");
assert(slice("hello", 3, 1) == "", "backwards slice is empty");

assert(str(42) == "42", "str of int");
assert(int("  42 ") == 42, "int parses with spaces");
assert(float("1.5") == 1.5, "float parses");
assert(type("x") == "string", "type");

let bad = try(fn() { return int("nope"); });
assert(has(bad, "err"), "unparseable int errors");

# format(): {} placeholders, {{}} escapes, strict counts.
assert(format("{} + {} = {}", 1, 2, 3) == "1 + 2 = 3", "format basics");
assert(format("no placeholders") == "no placeholders", "format passthrough");
assert(format("{{}} literal, {} filled", "x") == "{} literal, x filled", "format escapes");
assert(format("list: {}", [1, "a"]) == "list: [1, \"a\"]", "format renders like print");
let few = try(fn() { return format("{} {}", 1); });
assert(contains(few["err"], "placeholders"), "too few values errors");
let many = try(fn() { return format("{}", 1, 2); });
assert(contains(many["err"], "placeholder"), "too many values errors");
let stray = try(fn() { return format("oops }"); });
assert(contains(stray["err"], "stray"), "stray brace errors");

# \r escape (added in 2.11): a real carriage return, one char.
assert(len("\r") == 1, "cr is one char");
assert("a\rb" != "a\nb", "cr is not lf");
