# Emit playground/examples.js from examples/*.ting.
#
# Usage: ting tools/playground_examples.ting, from the repository root.
# Commit the result; tests/docs.rs checks it is in sync. Examples that
# read stdin or arguments are skipped (the browser has neither), and
# imports of "../lib/..." become "lib/..." so the embedded stdlib
# resolves them in the wasm build.
let path = import("lib/fs.ting");

let entries = {};
for name in list_dir("examples") {
  if ends_with(name, ".ting") {
    let src = read_file("examples/" + name);
    if !contains(src, "read_file(\"-\")") && !contains(src, "args()") {
      entries[path["stem"](name)] = replace(src, "\"../lib/", "\"lib/");
    }
  }
}

write_file("playground/examples.js", join([
  "// Generated by tools/playground_examples.ting from examples/*.ting.",
  "// Do not edit; regenerate.",
  format("const TING_EXAMPLES = {};", json_str(entries, 2)),
], "\n") + "\n");
