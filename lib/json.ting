# Nested-value helpers, written in ting. Use them via
#   let j = import("lib/json.ting");
# A path is a list of steps: strings index maps, ints index lists.

# The value at path, or nil when any step misses (a missing key, an
# index out of range, or a step into a non-container).
fn get_in(v, path) {
  let cur = v;
  for k in path {
    if type(k) == "string" {
      if type(cur) != "map" || !has(cur, k) { return nil; }
      cur = cur[k];
    } else if type(k) == "int" {
      if type(cur) != "list" || k < 0 || k >= len(cur) { return nil; }
      cur = cur[k];
    } else {
      fail("get_in: path steps must be strings or ints, got " + type(k));
    }
  }
  return cur;
}

# A fresh value with x placed at path: containers along the path are
# copied (the input is untouched), missing map keys are created, and
# a list index must already be in range.
fn set_in(v, path, x) {
  if len(path) == 0 { return x; }
  let k = path[0];
  let rest = slice(path, 1, len(path));
  if type(k) == "string" {
    let base = v;
    if base == nil { base = {}; }
    if type(base) != "map" { fail("set_in: expected a map before key " + k); }
    let out = {};
    for key in base { out[key] = base[key]; }
    let child = nil;
    if has(base, k) { child = base[k]; }
    out[k] = set_in(child, rest, x);
    return out;
  }
  if type(k) == "int" {
    if type(v) != "list" { fail("set_in: expected a list before index " + str(k)); }
    if k < 0 || k >= len(v) { fail("set_in: index " + str(k) + " out of range"); }
    let out = slice(v, 0, len(v));
    out[k] = set_in(v[k], rest, x);
    return out;
  }
  fail("set_in: path steps must be strings or ints, got " + type(k));
}

# Every path to a leaf (a non-container value), depth first, maps in
# key order and lists in index order. Empty containers contribute
# no paths.
fn paths(v) {
  let out = [];
  paths_into(v, [], out);
  return out;
}

fn paths_into(v, prefix, out) {
  if type(v) == "map" {
    for k in v { paths_into(v[k], prefix + [k], out); }
  } else if type(v) == "list" {
    for i in range(len(v)) { paths_into(v[i], prefix + [i], out); }
  } else {
    push(out, prefix);
  }
}

# Deep merge: where both a and b hold maps the merge recurses; any
# other value in b replaces a's (lists are replaced, not appended).
# Returns a fresh value; neither input is modified.
fn merge_in(a, b) {
  if type(a) != "map" || type(b) != "map" { return b; }
  let out = {};
  for k in a { out[k] = a[k]; }
  for k in b {
    if has(out, k) { out[k] = merge_in(out[k], b[k]); } else { out[k] = b[k]; }
  }
  return out;
}

# The differences between two values as [path, left, right] triples
# over the union of both sides' leaf paths, a's paths first; a path
# absent on one side reads as nil there.
fn diff(a, b) {
  let seen = paths(a);
  let all = slice(seen, 0, len(seen));
  for p in paths(b) {
    if !contains(seen, p) { push(all, p); }
  }
  let out = [];
  for p in all {
    let l = get_in(a, p);
    let r = get_in(b, p);
    if l != r { push(out, [p, l, r]); }
  }
  return out;
}
