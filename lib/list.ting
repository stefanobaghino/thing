# List helpers, written in ting. Use them via
#   let l = import("lib/list.ting");
# (the path is relative to the importing file).

fn sum(xs) { return reduce(xs, 0, fn(a, x) { return a + x; }); }

fn reverse(xs) {
  let out = [];
  let i = len(xs) - 1;
  while i >= 0 {
    push(out, xs[i]);
    i = i - 1;
  }
  return out;
}

fn zip(a, b) {
  let n = len(a);
  if len(b) < n { n = len(b); }
  let out = [];
  for i in range(n) { push(out, [a[i], b[i]]); }
  return out;
}

fn enumerate(xs) {
  let out = [];
  let i = 0;
  for x in xs {
    push(out, [i, x]);
    i = i + 1;
  }
  return out;
}

fn unique(xs) {
  let out = [];
  for x in xs {
    if !contains(out, x) { push(out, x); }
  }
  return out;
}

fn flatten(xs) {
  let out = [];
  for x in xs {
    if type(x) == "list" {
      for y in x { push(out, y); }
    } else {
      push(out, x);
    }
  }
  return out;
}
