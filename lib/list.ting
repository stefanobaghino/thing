# List helpers, written in ting. Use them via
#   let l = import("lib/list.ting");
# (the path is relative to the importing file).

fn sum(xs) { return reduce(xs, 0, fn(a, x) { return a + x; }); }

fn reverse(xs) {
  let out = [];
  let i = len(xs) - 1;
  while i >= 0 {
    push(out, xs[i]);
    i = i - 1;
  }
  return out;
}

fn zip(a, b) {
  let n = len(a);
  if len(b) < n { n = len(b); }
  let out = [];
  for i in range(n) { push(out, [a[i], b[i]]); }
  return out;
}

fn enumerate(xs) {
  let out = [];
  let i = 0;
  for x in xs {
    push(out, [i, x]);
    i = i + 1;
  }
  return out;
}

fn unique(xs) {
  let out = [];
  for x in xs {
    if !contains(out, x) { push(out, x); }
  }
  return out;
}

fn flatten(xs) {
  let out = [];
  for x in xs {
    if type(x) == "list" {
      for y in x { push(out, y); }
    } else {
      push(out, x);
    }
  }
  return out;
}

fn any(xs, pred) {
  for x in xs {
    if pred(x) { return true; }
  }
  return false;
}

fn all(xs, pred) {
  for x in xs {
    if !pred(x) { return false; }
  }
  return true;
}

# Element with the smallest key(x); nil for an empty list.
fn min_by(xs, key) {
  if len(xs) == 0 { return nil; }
  let best = xs[0];
  let best_k = key(best);
  for x in xs {
    let k = key(x);
    if k < best_k {
      best = x;
      best_k = k;
    }
  }
  return best;
}

# Element with the largest key(x); nil for an empty list.
fn max_by(xs, key) {
  if len(xs) == 0 { return nil; }
  let best = xs[0];
  let best_k = key(best);
  for x in xs {
    let k = key(x);
    if k > best_k {
      best = x;
      best_k = k;
    }
  }
  return best;
}

# Split into sublists of n (the last may be shorter); n must be > 0.
fn chunk(xs, n) {
  if n <= 0 { fail("chunk: size must be positive"); }
  let out = [];
  let cur = [];
  for x in xs {
    push(cur, x);
    if len(cur) == n {
      push(out, cur);
      cur = [];
    }
  }
  if len(cur) > 0 { push(out, cur); }
  return out;
}

# A fresh list with v inserted before index i (i == len appends);
# out-of-range fails.
fn insert_at(xs, i, v) {
  if i < 0 || i > len(xs) { fail("insert_at: index out of range"); }
  let out = [];
  let k = 0;
  for x in xs {
    if k == i { push(out, v); }
    push(out, x);
    k = k + 1;
  }
  if i == len(xs) { push(out, v); }
  return out;
}

# A fresh list without the element at index i; out-of-range fails.
fn remove_at(xs, i) {
  if i < 0 || i >= len(xs) { fail("remove_at: index out of range"); }
  let out = [];
  let k = 0;
  for x in xs {
    if k != i { push(out, x); }
    k = k + 1;
  }
  return out;
}

# Elements structurally equal to v.
fn count(xs, v) {
  let n = 0;
  for x in xs {
    if x == v { n = n + 1; }
  }
  return n;
}

# Arithmetic mean as a float; empty list fails.
fn mean(xs) {
  if len(xs) == 0 { fail("mean: empty list"); }
  return float(sum(xs)) / len(xs);
}

# Median of a numeric list: middle of the sorted values, or the mean
# of the two middles for even lengths (a float then); empty fails.
fn median(xs) {
  if len(xs) == 0 { fail("median: empty list"); }
  let sorted = sort(xs);
  let n = len(sorted);
  if n % 2 == 1 { return sorted[n / 2]; }
  return float(sorted[n / 2 - 1] + sorted[n / 2]) / 2;
}

# Map from key(x) (which must return a string) to the list of elements
# with that key, in input order.
fn group_by(xs, key) {
  let out = {};
  for x in xs {
    let k = key(x);
    if type(k) != "string" { fail("group_by: key must return a string, got " + type(k)); }
    if !has(out, k) { out[k] = []; }
    push(out[k], x);
  }
  return out;
}

# The first n elements (all of them when n exceeds the length); n < 0 fails.
fn take(xs, n) {
  if n < 0 { fail("take: negative count"); }
  if n > len(xs) { n = len(xs); }
  return slice(xs, 0, n);
}

# Everything after the first n elements (empty when n exceeds the
# length); n < 0 fails.
fn drop(xs, n) {
  if n < 0 { fail("drop: negative count"); }
  if n > len(xs) { n = len(xs); }
  return slice(xs, n, len(xs));
}

# [matching, rest]: the elements for which pred holds, then the others,
# each in input order.
fn partition(xs, pred) {
  let yes = [];
  let no = [];
  for x in xs {
    if pred(x) { push(yes, x); } else { push(no, x); }
  }
  return [yes, no];
}

# Sliding windows of n consecutive elements: [xs[0..n], xs[1..n+1], ...].
# Empty when the list is shorter than n; n must be positive.
fn window(xs, n) {
  if n <= 0 { fail("window: size must be positive"); }
  let out = [];
  let i = 0;
  while i + n <= len(xs) {
    push(out, slice(xs, i, i + n));
    i = i + 1;
  }
  return out;
}

# Map from key(x) (a string) to how many elements share that key.
fn count_by(xs, key) {
  let out = {};
  for x in xs {
    let k = key(x);
    if type(k) != "string" { fail("count_by: key must return a string, got " + type(k)); }
    if has(out, k) { out[k] = out[k] + 1; } else { out[k] = 1; }
  }
  return out;
}

# The first element, or nil when the list is empty.
fn first(xs) {
  if len(xs) == 0 { return nil; }
  return xs[0];
}

# The last element, or nil when the list is empty.
fn last(xs) {
  if len(xs) == 0 { return nil; }
  return xs[len(xs) - 1];
}

# Sum of f(x) over the elements (0 for an empty list).
fn sum_by(xs, f) { return sum(map(xs, f)); }

# A fresh list rotated left by n places (negative n rotates right);
# any n works, including multiples of the length.
fn rotate(xs, n) {
  let len_ = len(xs);
  if len_ == 0 { return []; }
  let k = n % len_;
  if k < 0 { k = k + len_; }
  return slice(xs, k, len_) + slice(xs, 0, k);
}

# First element for each distinct key(x) (structural equality on the
# keys), in input order.
fn unique_by(xs, key) {
  let seen = [];
  let out = [];
  for x in xs {
    let k = key(x);
    if !contains(seen, k) {
      push(seen, k);
      push(out, x);
    }
  }
  return out;
}

# Running reduce: every intermediate accumulator, starting with init
# (so the result has one more element than xs).
fn scan(xs, init, f) {
  let out = [init];
  let acc = init;
  for x in xs {
    acc = f(acc, x);
    push(out, acc);
  }
  return out;
}

# Elements of a and b alternated, starting with a; the longer tail
# is appended once the shorter runs out.
fn interleave(a, b) {
  let out = [];
  let n = len(a);
  if len(b) > n { n = len(b); }
  for i in range(n) {
    if i < len(a) { push(out, a[i]); }
    if i < len(b) { push(out, b[i]); }
  }
  return out;
}

# Map from each string element to how often it occurs (count_by with
# the identity; elements must be strings).
fn frequencies(xs) { return count_by(xs, fn(x) { return x; }); }

# Product of the elements (1 for an empty list).
fn product(xs) { return reduce(xs, 1, fn(a, x) { return a * x; }); }

# Mean of f(x) over the elements as a float; empty list fails.
fn mean_by(xs, f) { return mean(map(xs, f)); }

# A fresh list without the nil elements.
fn compact(xs) { return filter(xs, fn(x) { return x != nil; }); }

# A fresh list sorted by a three-way comparator: cmp(a, b) returns a
# negative int when a comes first, positive when b does, 0 for ties —
# which keep their input order (stable merge sort).
fn sort_with(xs, cmp) {
  if len(xs) <= 1 { return slice(xs, 0, len(xs)); }
  let mid = len(xs) / 2;
  let a = sort_with(slice(xs, 0, mid), cmp);
  let b = sort_with(slice(xs, mid, len(xs)), cmp);
  let out = [];
  let i = 0;
  let j = 0;
  while i < len(a) && j < len(b) {
    if cmp(b[j], a[i]) < 0 {
      push(out, b[j]);
      j = j + 1;
    } else {
      push(out, a[i]);
      i = i + 1;
    }
  }
  return out + slice(a, i, len(a)) + slice(b, j, len(b));
}
