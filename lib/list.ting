# List helpers, written in ting. Use them via
#   let l = import("lib/list.ting");
# (the path is relative to the importing file).

fn sum(xs) { return reduce(xs, 0, fn(a, x) { return a + x; }); }

fn reverse(xs) {
  let out = [];
  let i = len(xs) - 1;
  while i >= 0 {
    push(out, xs[i]);
    i = i - 1;
  }
  return out;
}

fn zip(a, b) {
  let n = len(a);
  if len(b) < n { n = len(b); }
  let out = [];
  for i in range(n) { push(out, [a[i], b[i]]); }
  return out;
}

fn enumerate(xs) {
  let out = [];
  let i = 0;
  for x in xs {
    push(out, [i, x]);
    i = i + 1;
  }
  return out;
}

fn unique(xs) {
  let out = [];
  for x in xs {
    if !contains(out, x) { push(out, x); }
  }
  return out;
}

fn flatten(xs) {
  let out = [];
  for x in xs {
    if type(x) == "list" {
      for y in x { push(out, y); }
    } else {
      push(out, x);
    }
  }
  return out;
}

fn any(xs, pred) {
  for x in xs {
    if pred(x) { return true; }
  }
  return false;
}

fn all(xs, pred) {
  for x in xs {
    if !pred(x) { return false; }
  }
  return true;
}

# Element with the smallest key(x); nil for an empty list.
fn min_by(xs, key) {
  if len(xs) == 0 { return nil; }
  let best = xs[0];
  let best_k = key(best);
  for x in xs {
    let k = key(x);
    if k < best_k {
      best = x;
      best_k = k;
    }
  }
  return best;
}

# Element with the largest key(x); nil for an empty list.
fn max_by(xs, key) {
  if len(xs) == 0 { return nil; }
  let best = xs[0];
  let best_k = key(best);
  for x in xs {
    let k = key(x);
    if k > best_k {
      best = x;
      best_k = k;
    }
  }
  return best;
}

# Split into sublists of n (the last may be shorter); n must be > 0.
fn chunk(xs, n) {
  if n <= 0 { fail("chunk: size must be positive"); }
  let out = [];
  let cur = [];
  for x in xs {
    push(cur, x);
    if len(cur) == n {
      push(out, cur);
      cur = [];
    }
  }
  if len(cur) > 0 { push(out, cur); }
  return out;
}

# A fresh list with v inserted before index i (i == len appends);
# out-of-range fails.
fn insert_at(xs, i, v) {
  if i < 0 || i > len(xs) { fail("insert_at: index out of range"); }
  let out = [];
  let k = 0;
  for x in xs {
    if k == i { push(out, v); }
    push(out, x);
    k = k + 1;
  }
  if i == len(xs) { push(out, v); }
  return out;
}

# A fresh list without the element at index i; out-of-range fails.
fn remove_at(xs, i) {
  if i < 0 || i >= len(xs) { fail("remove_at: index out of range"); }
  let out = [];
  let k = 0;
  for x in xs {
    if k != i { push(out, x); }
    k = k + 1;
  }
  return out;
}

# Elements structurally equal to v.
fn count(xs, v) {
  let n = 0;
  for x in xs {
    if x == v { n = n + 1; }
  }
  return n;
}
