# Math helpers, written in ting. Use them via
#   let ma = import("lib/math.ting");

fn clamp(x, lo, hi) { return min([max([x, lo]), hi]); }

fn sign(x) {
  if x > 0 { return 1; }
  if x < 0 { return -1; }
  return 0;
}

# Integer exponentiation by squaring; n must be >= 0.
fn pow(base, n) {
  if n < 0 { fail("pow: negative exponent"); }
  let result = 1;
  let b = base;
  let e = n;
  while e > 0 {
    if e % 2 == 1 { result = result * b; }
    e = e / 2;
    if e > 0 { b = b * b; }
  }
  return result;
}

fn gcd(a, b) {
  let x = abs(a);
  let y = abs(b);
  while y != 0 {
    let t = y;
    y = x % y;
    x = t;
  }
  return x;
}

# Nearest integer, halves away from zero: round(2.5) == 3, round(-2.5) == -3.
fn round(x) {
  if x >= 0 { return int(x + 0.5); }
  return -int(-x + 0.5);
}

# Newton's method square root; returns a float. x must be >= 0.
fn sqrt(x) {
  if x < 0 { fail("sqrt: negative input"); }
  if x == 0 { return 0.0; }
  let guess = float(x);
  for i in range(40) {
    guess = (guess + float(x) / guess) / 2.0;
  }
  return guess;
}

# Largest integer <= x. int() truncates toward zero, so negatives
# with a fractional part need one more step down.
fn floor(x) {
  let t = int(x);
  if float(t) > x { return t - 1; }
  return t;
}

# Smallest integer >= x.
fn ceil(x) {
  let t = int(x);
  if float(t) < x { return t + 1; }
  return t;
}

# Least common multiple (non-negative); 0 if either argument is 0.
fn lcm(a, b) {
  if a == 0 || b == 0 { return 0; }
  return abs(a / gcd(a, b) * b);
}

# |a - b|, for ints or floats.
fn abs_diff(a, b) { return abs(a - b); }

# True if n is a prime number (trial division; n < 2 is never prime).
fn is_prime(n) {
  if n < 2 { return false; }
  if n < 4 { return true; }
  if n % 2 == 0 { return false; }
  let d = 3;
  while d * d <= n {
    if n % d == 0 { return false; }
    d = d + 2;
  }
  return true;
}

# Population variance of a numeric list (mean of squared deviations)
# as a float; empty fails.
fn variance(xs) {
  if len(xs) == 0 { fail("variance: empty list"); }
  let total = 0.0;
  for x in xs { total = total + x; }
  let mean = total / len(xs);
  let acc = 0.0;
  for x in xs {
    let d = x - mean;
    acc = acc + d * d;
  }
  return acc / len(xs);
}

# Population standard deviation: sqrt(variance(xs)).
fn stddev(xs) { return sqrt(variance(xs)); }

# Nearest-rank percentile: the value at rank ceil(p / 100 * n) of the
# sorted list (rank 1 for p = 0). p must be in [0, 100]; empty fails.
fn percentile(xs, p) {
  if len(xs) == 0 { fail("percentile: empty list"); }
  if p < 0 || p > 100 { fail("percentile: p must be in [0, 100]"); }
  let sorted = sort(xs);
  let n = len(sorted);
  let rank = ceil(float(p) * n / 100.0);
  if rank < 1 { rank = 1; }
  return sorted[rank - 1];
}
