# Civil dates from the clock, written in ting on top of time_ms().
# Use them via
#   let time = import("lib/time.ting");
#
# Everything takes or returns milliseconds since the Unix epoch, and
# every conversion here is UTC: this module carries no zone database,
# because a zone is a database and this is a module. The local_
# functions are the exception that proves it — they ask the PLATFORM,
# through the local_zone() builtin, and answer nil where it keeps no
# zone data. The conversions are Howard Hinnant's days-from-civil
# algorithms, which are exact for every year an i64 of milliseconds
# can reach.

# Every field of an instant: year, month, day, hour, minute, second,
# ms, and weekday (0 is Sunday).
fn parts(ms) {
  let days = fdiv(ms, 86400000);
  let rest = fmod(ms, 86400000);
  let date = civil_from_days(days);
  return {
    "year": date["year"],
    "month": date["month"],
    "day": date["day"],
    "hour": rest / 3600000,
    "minute": rest % 3600000 / 60000,
    "second": rest % 60000 / 1000,
    "ms": rest % 1000,
    "weekday": fmod(days + 4, 7),
  };
}

# Milliseconds since the epoch for a civil date and time, UTC.
fn from_parts(y, mo, d, h, mi, s) {
  return days_from_civil(y, mo, d) * 86400000 + h * 3600000 + mi * 60000 + s * 1000;
}

# The instant as ISO 8601 in UTC: 2026-09-04T20:33:12Z.
fn iso(ms) { return date(ms) + "T" + clock(ms) + "Z"; }

# Milliseconds from an ISO 8601 instant, or nil when the string is not
# one. This is iso()'s inverse and more: it also reads a date on its
# own (midnight), a space instead of the T that databases write,
# seconds and fractional seconds when they are there, and an offset
# like +02:00 or -0500, which it applies.
#
# It is a question, not a demand — a timestamp read out of a file may
# be anything, so an unreadable one answers nil rather than raising,
# the way stat does for a path. What it must never do is answer
# confidently: the five lines a script writes without it happily turn
# "2026-13-45T99:99:99Z" into a number, and every month, day, hour,
# minute and second here is checked against what exists, February the
# 30th included.
#
# A string with no offset is read as UTC. That is a convention rather
# than a guess: this module has no notion of a local zone anywhere, so
# there is nothing else it could mean.
fn from_iso(s) {
  if type(s) != "string" || len(s) < 10 { return nil; }
  if slice(s, 4, 5) != "-" || slice(s, 7, 8) != "-" { return nil; }
  let ys = slice(s, 0, 4);
  let mos = slice(s, 5, 7);
  let ds = slice(s, 8, 10);
  if !digits(ys) || !digits(mos) || !digits(ds) { return nil; }
  let y = int(ys);
  let mo = int(mos);
  let d = int(ds);
  if mo < 1 || mo > 12 { return nil; }
  if d < 1 || d > days_in_month(y, mo) { return nil; }

  let rest = slice(s, 10, len(s));
  if rest == "" { return from_parts(y, mo, d, 0, 0, 0); }
  let head = slice(rest, 0, 1);
  if head != "T" && head != " " { return nil; }
  rest = slice(rest, 1, len(rest));

  if len(rest) < 5 || slice(rest, 2, 3) != ":" { return nil; }
  let hs = slice(rest, 0, 2);
  let mis = slice(rest, 3, 5);
  if !digits(hs) || !digits(mis) { return nil; }
  let h = int(hs);
  let mi = int(mis);
  if h > 23 || mi > 59 { return nil; }
  rest = slice(rest, 5, len(rest));

  let sec = 0;
  if slice(rest, 0, 1) == ":" {
    let ss = slice(rest, 1, 3);
    if !digits(ss) { return nil; }
    sec = int(ss);
    # A leap second is a real thing this cannot represent, so :60 is
    # refused rather than quietly moved to the next minute.
    if sec > 59 { return nil; }
    rest = slice(rest, 3, len(rest));
  }

  let millis = 0;
  if slice(rest, 0, 1) == "." {
    let frac = "";
    let i = 1;
    while i < len(rest) && digits(slice(rest, i, i + 1)) {
      frac = frac + slice(rest, i, i + 1);
      i += 1;
    }
    if frac == "" { return nil; }
    # Milliseconds are the resolution: more digits are dropped rather
    # than rounded, fewer are padded.
    millis = int(slice(frac + "000", 0, 3));
    rest = slice(rest, i, len(rest));
  }

  let offset = 0;
  if rest != "" && rest != "Z" && rest != "z" {
    let sign = slice(rest, 0, 1);
    if sign != "+" && sign != "-" { return nil; }
    let body = replace(slice(rest, 1, len(rest)), ":", "");
    if len(body) != 4 || !digits(body) { return nil; }
    let oh = int(slice(body, 0, 2));
    let om = int(slice(body, 2, 4));
    if oh > 23 || om > 59 { return nil; }
    offset = oh * 3600000 + om * 60000;
    if sign == "-" { offset = -offset; }
  }

  return from_parts(y, mo, d, h, mi, sec) + millis - offset;
}

# The three questions that need a zone, and cannot be answered without
# one: what day is it here, what time of day, and the instant written
# so that it carries where "here" was. Each answers nil where the
# platform keeps no zone data, rather than quietly handing back the
# UTC answer under a local name — a caller that wants UTC as a
# fallback should say so, in its own code, where a reader can see it.
fn local_date(ms) {
  let z = local_zone(ms);
  if z == nil { return nil; }
  return date(ms + z["offset"]);
}

# The time of day in the local zone at that instant, as clock()
# writes it; nil where the platform keeps no zone data to read.
fn local_clock(ms) {
  let z = local_zone(ms);
  if z == nil { return nil; }
  return clock(ms + z["offset"]);
}

# 2026-09-07T00:30:00+02:00, which from_iso reads back to the same
# instant — exactly, unless the offset has seconds in it, which only
# the local mean times before about 1900 do.
fn local_iso(ms) {
  let z = local_zone(ms);
  if z == nil { return nil; }
  let shifted = ms + z["offset"];
  return date(shifted) + "T" + clock(shifted) + offset_iso(z["offset"]);
}

# An offset in milliseconds east of UTC, written the way ISO 8601
# writes one: "Z" for none, "+02:00", "-05:30". ISO has no room for
# seconds in an offset, and a handful of pre-1900 local mean times
# have them, so those are truncated towards zero — which is what date
# prints for them too.
fn offset_iso(off) {
  if off == 0 { return "Z"; }
  let sign = "+";
  let n = off;
  if n < 0 {
    sign = "-";
    n = -n;
  }
  let minutes = n / 60000;
  return sign + format("{:02}:{:02}", minutes / 60, minutes % 60);
}

# Whether every character is a digit, and there is at least one.
fn digits(s) {
  if len(s) == 0 { return false; }
  for c in s {
    if c < "0" || c > "9" { return false; }
  }
  return true;
}

# The date as YYYY-MM-DD.
fn date(ms) {
  let p = parts(ms);
  return format("{:04}-{:02}-{:02}", p["year"], p["month"], p["day"]);
}

# The time of day as HH:MM:SS.
fn clock(ms) {
  let p = parts(ms);
  return format("{:02}:{:02}:{:02}", p["hour"], p["minute"], p["second"]);
}

# A span of milliseconds as "1h 2m 3s", dropping the leading zero
# units; under a second it reads in milliseconds.
fn span(ms) {
  if ms < 0 { return "-" + span(-ms); }
  if ms < 1000 { return str(ms) + "ms"; }
  let out = "";
  let total = ms / 1000;
  let h = total / 3600;
  let m = total % 3600 / 60;
  let s = total % 60;
  if h > 0 { out = out + str(h) + "h "; }
  if h > 0 || m > 0 { out = out + str(m) + "m "; }
  return out + str(s) + "s";
}

# The name of a weekday number, 0 being Sunday. With short, the
# three-letter form the world writes in logs and mail headers.
fn weekday_name(n, short = false) {
  if n < 0 || n > 6 { fail("weekday out of range: " + str(n)); }
  if short { return slice(WEEKDAYS[n], 0, 3); }
  return WEEKDAYS[n];
}

# The name of a month number, 1 being January; short as above.
fn month_name(m, short = false) {
  if m < 1 || m > 12 { fail("month out of range: " + str(m)); }
  if short { return slice(MONTHS[m - 1], 0, 3); }
  return MONTHS[m - 1];
}

# The number of a month written as a name: 9 for "September", "Sep"
# or "sep". Anything else fails, since a name nobody writes is a
# mistake rather than a month.
fn month_number(name) {
  let n = name_index(MONTHS, name);
  if n == nil { fail("not a month name: " + str(name)); }
  return n + 1;
}

# The same for a weekday: 0 for "Sunday", "Sun" or "sun".
fn weekday_number(name) {
  let n = name_index(WEEKDAYS, name);
  if n == nil { fail("not a weekday name: " + str(name)); }
  return n;
}

# Where a name sits in a list of names, matching the whole name or
# its first three letters, either case. nil when it sits nowhere.
fn name_index(names, name) {
  if type(name) != "string" { return nil; }
  let want = lower(name);
  for i in range(len(names)) {
    let full = lower(names[i]);
    if want == full || want == slice(full, 0, 3) { return i; }
  }
  return nil;
}

# The month names, read by month_name and month_number.
let MONTHS = ["January", "February", "March", "April", "May", "June",
"July", "August", "September", "October", "November", "December"];

# The weekday names, 0 being Sunday, read by the pair above.
let WEEKDAYS = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];

# Whether the year has a February 29th.
fn is_leap(y) { return y % 4 == 0 && (y % 100 != 0 || y % 400 == 0); }

# Days in the month (1-12) of that year.
fn days_in_month(y, m) {
  let lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
  if m < 1 || m > 12 { fail("month out of range: " + str(m)); }
  if m == 2 && is_leap(y) { return 29; }
  return lengths[m - 1];
}

# Days since 1970-01-01 for a civil date.
fn days_from_civil(y, m, d) {
  let year = y;
  if m <= 2 { year = year - 1; }
  let era = fdiv(year, 400);
  let yoe = year - era * 400;
  let mp = m + 9;
  if m > 2 { mp = m - 3; }
  let doy = (153 * mp + 2) / 5 + d - 1;
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
  return era * 146097 + doe - 719468;
}

# The civil date for a day count: {"year": y, "month": m, "day": d}.
fn civil_from_days(z) {
  let days = z + 719468;
  let era = fdiv(days, 146097);
  let doe = days - era * 146097;
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
  let y = yoe + era * 400;
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
  let mp = (5 * doy + 2) / 153;
  let d = doy - (153 * mp + 2) / 5 + 1;
  let m = mp + 3;
  if mp >= 10 { m = mp - 9; }
  if m <= 2 { y = y + 1; }
  return {"year": y, "month": m, "day": d};
}

# Floor division, since ting's / truncates toward zero and the era
# arithmetic below needs the floor for dates before 1970.
fn fdiv(a, b) {
  let q = a / b;
  if a % b != 0 && ((a < 0) != (b < 0)) { return q - 1; }
  return q;
}

# The remainder that goes with fdiv: always has the sign of b.
fn fmod(a, b) { return a - fdiv(a, b) * b; }

# A timestamp in a shape the world writes, read with the strftime
# codes it is usually described by: parse("12/Sep/2026:06:00:01",
# "%d/%b/%Y:%H:%M:%S"). The codes are %Y %y %m %b %B %d %e %H %I %M
# %S %L %p %a %A %z and %%, plus %F for %Y-%m-%d, %T for %H:%M:%S and
# %D for %m/%d/%y. Everything else in the pattern stands for itself,
# and a space matches one space or several — syslog writes "Sep  3".
#
# nil when the text does not match the shape, the way from_iso
# answers nil: the text comes from the world and not matching is
# something a program handles. A code that is not in the list above
# FAILS, because the pattern is the program's own.
#
# Fields the pattern does not name come from defaults, a parts-shaped
# map, and otherwise from 1970-01-01T00:00:00Z — which is how a
# syslog line without a year is read: parse(s, "%b %e %H:%M:%S",
# {"year": 2026}).
fn parse(s, pattern, defaults = nil) {
  if type(s) != "string" || type(pattern) != "string" { return nil; }
  let f = {"year": 1970, "month": 1, "day": 1, "hour": 0, "minute": 0,
    "second": 0, "ms": 0, "offset": 0, "pm": nil};
  if defaults != nil {
    for k in keys(f) {
      if has(defaults, k) { f[k] = defaults[k]; }
    }
  }
  let p = expand(pattern);
  let i = 0;
  let j = 0;
  while i < len(p) {
    let c = slice(p, i, i + 1);
    if c == "%" {
      let code = slice(p, i + 1, i + 2);
      i = i + 2;
      if code == "%" {
        if slice(s, j, j + 1) != "%" { return nil; }
        j = j + 1;
      } else {
        let step = read_code(s, j, code, f);
        if step == nil { return nil; }
        j = step;
      }
    } else if c == " " {
      if slice(s, j, j + 1) != " " { return nil; }
      while slice(s, j, j + 1) == " " { j = j + 1; }
      i = i + 1;
    } else {
      if slice(s, j, j + 1) != c { return nil; }
      i = i + 1;
      j = j + 1;
    }
  }
  if j != len(s) { return nil; }
  if f["pm"] != nil {
    if f["hour"] < 1 || f["hour"] > 12 { return nil; }
    f["hour"] = f["hour"] % 12;
    if f["pm"] { f["hour"] = f["hour"] + 12; }
  }
  if f["month"] < 1 || f["month"] > 12 { return nil; }
  if f["day"] < 1 || f["day"] > days_in_month(f["year"], f["month"]) { return nil; }
  if f["hour"] > 23 || f["minute"] > 59 || f["second"] > 59 { return nil; }
  return from_parts(f["year"], f["month"], f["day"], f["hour"], f["minute"], f["second"])
  + f["ms"] - f["offset"];
}

# The three shorthand codes, written out before the walk.
fn expand(pattern) {
  let out = replace(pattern, "%F", "%Y-%m-%d");
  out = replace(out, "%T", "%H:%M:%S");
  return replace(out, "%D", "%m/%d/%y");
}

# One code against the text at j: the field it names is written into
# f, and the new j comes back. nil when the text does not have it.
fn read_code(s, j, code, f) {
  if code == "Y" { return read_int(s, j, 4, "year", f); }
  if code == "m" { return read_int(s, j, 2, "month", f); }
  if code == "d" { return read_int(s, j, 2, "day", f); }
  if code == "H" || code == "I" { return read_int(s, j, 2, "hour", f); }
  if code == "M" { return read_int(s, j, 2, "minute", f); }
  if code == "S" { return read_int(s, j, 2, "second", f); }
  if code == "y" {
    let step = read_int(s, j, 2, "year", f);
    if step == nil { return nil; }
    # POSIX: 69-99 is the last century, 00-68 this one.
    if f["year"] > 68 { f["year"] = 1900 + f["year"]; } else { f["year"] = 2000 + f["year"]; }
    return step;
  }
  if code == "e" {
    let at = j;
    while slice(s, at, at + 1) == " " { at = at + 1; }
    return read_int(s, at, 2, "day", f);
  }
  if code == "L" {
    let at = j;
    let text = "";
    while len(text) < 3 && digits(slice(s, at, at + 1)) {
      text = text + slice(s, at, at + 1);
      at = at + 1;
    }
    if text == "" { return nil; }
    f["ms"] = int(text) * pow10(3 - len(text));
    return at;
  }
  if code == "b" || code == "h" || code == "B" { return read_name(s, j, MONTHS, "month", f); }
  if code == "a" || code == "A" { return read_name(s, j, WEEKDAYS, nil, f); }
  if code == "p" { return read_meridiem(s, j, f); }
  if code == "z" { return read_offset(s, j, f); }
  fail("not a pattern code: %" + code);
}

# Up to width digits, as few as one, into the named field.
fn read_int(s, j, width, field, f) {
  let at = j;
  let text = "";
  while len(text) < width && digits(slice(s, at, at + 1)) {
    text = text + slice(s, at, at + 1);
    at = at + 1;
  }
  if text == "" { return nil; }
  f[field] = int(text);
  return at;
}

# A month or weekday name, full or three-letter, either case. field
# of nil reads the name and throws it away, which is what a weekday
# in a stamp is: already implied by the date.
fn read_name(s, j, names, field, f) {
  for i in range(len(names)) {
    for form in [names[i], slice(names[i], 0, 3)] {
      if lower(slice(s, j, j + len(form))) == lower(form) {
        if field != nil { f[field] = i + 1; }
        return j + len(form);
      }
    }
  }
  return nil;
}

# AM or PM, either case, kept until the hour is known.
fn read_meridiem(s, j, f) {
  let two = lower(slice(s, j, j + 2));
  if two == "am" { f["pm"] = false; return j + 2; }
  if two == "pm" { f["pm"] = true; return j + 2; }
  return nil;
}

# +HHMM, +HH:MM or Z, as an offset in milliseconds east of UTC.
fn read_offset(s, j, f) {
  let sign = slice(s, j, j + 1);
  if sign == "Z" || sign == "z" { f["offset"] = 0; return j + 1; }
  if sign != "+" && sign != "-" { return nil; }
  let at = j + 1;
  if !digits(slice(s, at, at + 2)) { return nil; }
  let h = int(slice(s, at, at + 2));
  at = at + 2;
  if slice(s, at, at + 1) == ":" { at = at + 1; }
  if !digits(slice(s, at, at + 2)) { return nil; }
  let mi = int(slice(s, at, at + 2));
  at = at + 2;
  let off = (h * 3600 + mi * 60) * 1000;
  if sign == "-" { off = -off; }
  f["offset"] = off;
  return at;
}

# Ten to the n, for the three places after a decimal point.
fn pow10(n) {
  let out = 1;
  for i in range(n) { out = out * 10; }
  return out;
}

# An instant written in a shape the world reads, with the same codes
# parse takes: text(ms, "%d/%b/%Y:%H:%M:%S") is an access log,
# text(ms, "%b %e %H:%M:%S") is syslog. This is parse's inverse, and
# csv's text is its namesake — a module's parse reads its subject,
# its text writes one.
#
# offset shifts the instant east of UTC before it is written, and is
# what %z writes: everything else here is UTC, so without it %z would
# only ever say +0000. A code that is not in the list FAILS, the way
# it does in a pattern being read.
fn text(ms, pattern, offset = 0) {
  let p = expand(pattern);
  let at = parts(ms + offset);
  let out = "";
  let i = 0;
  while i < len(p) {
    let c = slice(p, i, i + 1);
    if c == "%" {
      out = out + write_code(slice(p, i + 1, i + 2), at, offset);
      i = i + 2;
    } else {
      out = out + c;
      i = i + 1;
    }
  }
  return out;
}

# One code as the text it stands for, from an already-shifted parts
# map. The hour codes read the same field three ways: %H is the
# twenty-four hour clock, %I the twelve, %p which half it is in.
fn write_code(code, at, offset) {
  if code == "Y" { return format("{:04}", at["year"]); }
  if code == "y" { return format("{:02}", fmod(at["year"], 100)); }
  if code == "m" { return format("{:02}", at["month"]); }
  if code == "d" { return format("{:02}", at["day"]); }
  if code == "e" { return format("{:2}", at["day"]); }
  if code == "H" { return format("{:02}", at["hour"]); }
  if code == "I" {
    let twelve = at["hour"] % 12;
    if twelve == 0 { twelve = 12; }
    return format("{:02}", twelve);
  }
  if code == "p" {
    if at["hour"] >= 12 { return "PM"; }
    return "AM";
  }
  if code == "M" { return format("{:02}", at["minute"]); }
  if code == "S" { return format("{:02}", at["second"]); }
  if code == "L" { return format("{:03}", at["ms"]); }
  if code == "b" || code == "h" { return month_name(at["month"], true); }
  if code == "B" { return month_name(at["month"]); }
  if code == "a" { return weekday_name(at["weekday"], true); }
  if code == "A" { return weekday_name(at["weekday"]); }
  if code == "z" { return offset_text(offset); }
  if code == "%" { return "%"; }
  fail("not a pattern code: %" + code);
}

# An offset as strftime writes one: +HHMM, no colon and no Z.
fn offset_text(off) {
  let sign = "+";
  let n = off;
  if n < 0 {
    sign = "-";
    n = -n;
  }
  let minutes = n / 60000;
  return sign + format("{:02}{:02}", minutes / 60, minutes % 60);
}
