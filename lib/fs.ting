# Paths and directory walking, written in ting on top of the
# filesystem builtins. Use them via
#   let fs = import("lib/fs.ting");
#
# Paths are split on both "/" and "\", so a path that came from a
# Windows tool parses here, and joined with "/", which every platform
# the binary runs on accepts.
#
# What these answer about a path depends on what is at it, and the
# three answers are worth knowing before reading any one of them:
#
#   nothing there   every function here that touches the filesystem
#                   raises, in the words the builtin that had to
#                   look gives. Two do not: size answers nil, the
#                   way stat and exists do, because it is a question
#                   where the rest are demands; and remove_tree is
#                   quiet, a delete with nothing to delete having
#                   done its job. The path functions above — parts,
#                   base, dir, ext, stem, join_path, with_ext — read
#                   the string and never look at all
#   a file          the walkers take it as a tree of one: walk and
#                   walk_ext answer [that file] (walk_ext only if
#                   the extension matches), facts its facts and
#                   total_size its bytes. The readers read it. Only
#                   entries refuses, a file having no entries
#   a directory     the walkers walk it, the directories themselves
#                   left out. The readers raise: a directory is not
#                   lines. size answers the directory's own
#                   bookkeeping size, which is exactly what
#                   total_size leaves out

# The path with backslashes turned into forward slashes.
fn normal(p) { return replace(p, "\\", "/"); }

# The pieces of a path, with empty ones dropped: "a//b/" is ["a", "b"].
fn parts(p) {
  let out = [];
  for piece in split(normal(p), "/") {
    if piece != "" { push(out, piece); }
  }
  return out;
}

# The last component of a path: base("a/b/c.ting") is "c.ting".
# A path with nothing in it answers "".
fn base(p) {
  let ps = parts(p);
  if len(ps) == 0 { return ""; }
  return ps[-1];
}

# Everything before the last component: dir("a/b/c") is "a/b",
# dir("c") is ".", and an absolute path keeps its leading "/".
fn dir(p) {
  let ps = parts(p);
  let rooted = starts_with(normal(p), "/");
  if len(ps) <= 1 {
    if rooted { return "/"; }
    return ".";
  }
  let head = join(slice(ps, 0, len(ps) - 1), "/");
  if rooted { return "/" + head; }
  return head;
}

# The extension of a path without its dot: ext("a/b.ting") is "ting".
# A name with no dot, or one that only starts with a dot (".bashrc"),
# has no extension and answers "".
fn ext(p) {
  let name = base(p);
  let cut = -1;
  let i = 0;
  while i < len(name) {
    if name[i] == "." { cut = i; }
    i += 1;
  }
  if cut <= 0 { return ""; }
  return slice(name, cut + 1, len(name));
}

# The last component without its extension: stem("a/b.ting") is "b".
fn stem(p) {
  let name = base(p);
  let e = ext(p);
  if e == "" { return name; }
  return slice(name, 0, len(name) - len(e) - 1);
}

# The pieces joined with "/", each one's own separators tidied away:
# join_path(["a/", "b", "c.ting"]) is "a/b/c.ting". An absolute first
# piece keeps its leading "/".
fn join_path(pieces) {
  let all = [];
  for piece in pieces {
    for one in parts(piece) { push(all, one); }
  }
  let out = join(all, "/");
  if len(pieces) > 0 && starts_with(normal(pieces[0]), "/") { return "/" + out; }
  return out;
}

# The path with a different extension: with_ext("a/b.ting", "md") is
# "a/b.md". An empty extension removes the dot as well.
fn with_ext(p, e) {
  let head = dir(p);
  let name = stem(p);
  if e != "" { name = name + "." + e; }
  if head == "." && !starts_with(normal(p), "./") { return name; }
  return join_path([head, name]);
}

# The direct children of a directory as paths, sorted — what list_dir
# says, each prefixed with the directory it came from.
fn entries(d) {
  let out = [];
  for name in list_dir(d) { push(out, join_path([d, name])); }
  return out;
}

# Every file at or below a directory, sorted, directories themselves
# left out — the list a tool that runs over a tree wants. A path that
# is a file answers just that path; a path that is nothing at all is
# an error, because an absent tree is not an empty one and a script
# that mistyped a directory would otherwise read as having found
# nothing. list_dir is the builtin that would have had to look, so it
# says so, in whatever words this platform gives it.
fn walk(d) {
  if !exists(d) { list_dir(d); }
  if !is_dir(d) { return [d]; }
  let out = [];
  for child in entries(d) {
    if is_dir(child) {
      for deeper in walk(child) { push(out, deeper); }
    } else {
      push(out, child);
    }
  }
  return out;
}

# Every file at or below a directory whose extension is e, sorted:
# walk_ext("src", "ting") is every ting file in the tree.
fn walk_ext(d, e) {
  let out = [];
  for path in walk(d) {
    if ext(path) == e { push(out, path); }
  }
  return out;
}

# How big a file is, in bytes, or nil when nothing readable is there
# — stat's answer, without the map. Worth its own name because a size
# is asked for far more often than the rest of a file's facts, and
# `len(read_file(p))` is the wrong way to get one: that counts
# characters, and refuses a file that is not text.
fn size(p) {
  let facts = stat(p);
  if facts == nil { return nil; }
  return facts["size"];
}

# Every file at or below a directory with what stat says about it:
# maps of path, size, modified and kind, sorted by path. One stat per
# file, which is the point: sorting `walk`'s paths by size instead
# calls stat inside the comparator, once per comparison rather than
# once per file. Over 5132 files that measured 249 ms against 139 ms
# for asking here first and sorting the answers.
fn facts(d) {
  let out = [];
  for path in walk(d) {
    let f = stat(path);
    if f != nil {
      push(out, {"path": path, "size": f["size"], "modified": f["modified"], "kind": f["kind"]});
    }
  }
  return out;
}

# The bytes at or below a directory: what `du` reports, minus the
# directories themselves, which the filesystem sizes for its own
# bookkeeping rather than by what they hold.
fn total_size(d) {
  let total = 0;
  for f in facts(d) { total += f["size"]; }
  return total;
}

# How many lines a file has, without ever holding it. `wc -l` counts
# newline characters; this counts lines, so a last line with nothing
# after it still counts as one, which is what each_line gives.
fn count_lines(p) {
  return each_line(p, fn(_l) { return nil; });
}

# The first n lines, reading no further: each_line stops when the
# function answers false, so this costs what the first n lines cost
# and not what the file does.
fn head(p, n) {
  if n <= 0 { return []; }
  let out = [];
  each_line(p, fn(l) {
    push(out, l);
    return len(out) < n;
  });
  return out;
}

# The last n lines, holding only n of them. The obvious way — push
# every line, drop the front when the list grows past n — copies the
# whole window once per line: over 1000000 lines that measured 2007 ms
# at n = 10 and 75000 ms at n = 1000. Writing into a ring and
# unrolling it once at the end costs the same whatever n is: 925 ms
# and 926 ms for those two.
fn tail(p, n) {
  if n <= 0 { return []; }
  let ring = [];
  let seen = 0;
  each_line(p, fn(l) {
    if len(ring) < n { push(ring, l); } else { ring[seen % n] = l; }
    seen += 1;
    return nil;
  });
  if seen <= n { return ring; }
  let start = seen % n;
  return slice(ring, start, n) + slice(ring, 0, start);
}

# Every line containing needle, in order. The file is never held; the
# answer is, so a needle that matches every line costs what reading
# the whole file would.
fn lines_matching(p, needle) {
  let out = [];
  each_line(p, fn(l) {
    if contains(l, needle) { push(out, l); }
    return nil;
  });
  return out;
}

# A file moved, wherever it has to go. rename is the whole operation
# when both paths are on one filesystem: nothing is copied, so the
# size does not matter and the modification time comes through
# untouched. It refuses across filesystems, and there this does what
# `mv` does — copy the bytes, then remove the original — which is
# slower, holds nothing in memory, and is not atomic: a failure
# between the two leaves the file at both names. Written here rather
# than in the binary so that the fallback is readable, and so the
# rare case cannot pretend to be the cheap one.
fn move(from, to) {
  if has(try(rename, from, to), "ok") { return nil; }
  # Not read from the message: whatever stopped the rename will stop
  # the copy too, and the copy's own error says it better.
  copy_file(from, to);
  remove_file(from);
  return nil;
}

# Every file and directory at or below a path, gone. Files first, then
# each directory once it is empty, deepest first — which is what
# remove_dir needs, and why this is written here in ting rather than
# hidden behind a builtin: a recursive delete should be readable.
fn remove_tree(p) {
  if !exists(p) { return nil; }
  if !is_dir(p) {
    remove_file(p);
    return nil;
  }
  for child in entries(p) { remove_tree(child); }
  remove_dir(p);
  return nil;
}
