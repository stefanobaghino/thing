# String helpers, written in ting. Use them via
#   let s = import("lib/string.ting");

# s written n times end to end; n of zero or less gives "".
fn repeat(s, n) {
  let out = "";
  for i in range(n) { out = out + s; }
  return out;
}

# s padded with fill on the LEFT until it is width COLUMNS wide,
# which right-aligns it in a column of that width. A string already
# that wide is returned unchanged; a wide fill can overshoot by a
# column. format's `{:>5}` does the same inside a template. The fill
# defaults to a space, which is what a column of text wants and what
# every caller here passed.
fn pad_left(s, width, fill = " ") {
  let step = display_width(fill);
  if step <= 0 { fail("pad_left: fill must take at least one column"); }
  let gap = width - display_width(s);
  if gap <= 0 { return s; }
  return repeat(fill, (gap + step - 1) / step) + s;
}

# s padded with fill on the RIGHT until it is width COLUMNS wide,
# which left-aligns it in a column of that width. A string already
# that wide is returned unchanged; a wide fill can overshoot by a
# column. format's `{:<5}` does the same inside a template. The fill
# defaults to a space.
fn pad_right(s, width, fill = " ") {
  let step = display_width(fill);
  if step <= 0 { fail("pad_right: fill must take at least one column"); }
  let gap = width - display_width(s);
  if gap <= 0 { return s; }
  return s + repeat(fill, (gap + step - 1) / step);
}

# s centred in width using fill on both sides; the extra column of an
# odd gap goes on the right. fill must be one column wide, and is a
# space unless another is given.
fn center(s, width, fill = " ") {
  if display_width(fill) != 1 { fail("center: fill must be one column wide"); }
  let gap = width - display_width(s);
  if gap <= 0 { return s; }
  return repeat(fill, gap / 2) + s + repeat(fill, gap - gap / 2);
}

# The text cut into its lines at every newline. A trailing newline
# leaves a final empty string, as split does.
fn lines(s) { return split(s, "\n"); }

# Each space-separated word with its first character upper-cased;
# the rest of every word is left exactly as it was.
fn title(s) {
  let out = [];
  for w in split(s, " ") {
    if w == "" {
      push(out, w);
    } else {
      push(out, upper(slice(w, 0, 1)) + slice(w, 1, len(w)));
    }
  }
  return join(out, " ");
}

# [before, after] around the first separator, or nil if absent.
fn split_once(s, sep) {
  let i = find(s, sep);
  if i == nil { return nil; }
  return [slice(s, 0, i), slice(s, i + len(sep), len(s))];
}

# Leading whitespace (space, tab, newline, carriage return) removed.
fn trim_start(s) {
  let i = 0;
  while i < len(s) && contains(" \t\n\r", s[i]) { i = i + 1; }
  return slice(s, i, len(s));
}

# Trailing whitespace removed.
fn trim_end(s) {
  let i = len(s);
  while i > 0 && contains(" \t\n\r", s[i - 1]) { i = i - 1; }
  return slice(s, 0, i);
}

# Non-overlapping occurrences of sub in s; sub must be non-empty.
fn count(s, sub) {
  if len(sub) == 0 { fail("count: empty substring"); }
  let n = 0;
  let rest = s;
  while true {
    let i = find(rest, sub);
    if i == nil { break; }
    n += 1;
    rest = slice(rest, i + len(sub), len(rest));
  }
  return n;
}

# The characters of s as a list of one-character strings.
fn chars(s) {
  let out = [];
  for c in s { push(out, c); }
  return out;
}

# s with its characters in reverse order.
fn reverse(s) {
  let out = "";
  let i = len(s);
  while i > 0 {
    i -= 1;
    out += s[i];
  }
  return out;
}

# True if s is non-empty and every character is an ASCII digit.
fn is_digit(s) {
  if len(s) == 0 { return false; }
  for c in s {
    if !contains("0123456789", c) { return false; }
  }
  return true;
}

# True if s is non-empty and every character is a cased letter — one
# whose upper- and lowercase forms differ, which covers accented
# Latin, Greek and Cyrillic letters but not scripts without case.
fn is_alpha(s) {
  if len(s) == 0 { return false; }
  for c in s {
    if upper(c) == lower(c) { return false; }
  }
  return true;
}

# The whitespace-separated words of s (runs of spaces, tabs and
# newlines count as one separator; no empty words).
fn words(s) {
  # Every separator becomes a space, then one split does the work.
  # Looking at each character in ting costs more than three passes
  # through replace and one through split, which are builtins.
  let flat = replace(replace(replace(s, "\t", " "), "\n", " "), "\r", " ");
  return filter(split(flat, " "), fn(w) { return w != ""; });
}

# s with every run of whitespace (spaces, tabs, newlines) collapsed to
# one space and the ends trimmed: "a  b\n c" becomes "a b c".
fn squeeze(s) {
  return join(words(s), " ");
}

# The count and the right noun for it: plural(1, "file", "files") is
# "1 file", plural(3, "file", "files") is "3 files" — for summaries.
fn plural(n, one, many) {
  if n == 1 { return "1 " + one; }
  return str(n) + " " + many;
}

# The English ordinal for an integer: "1st", "2nd", "3rd", "4th",
# and "th" for the teens ("11th", "12th", "13th") whatever their last
# digit. Negative counts keep their sign ("-1st"); a non-integer fails.
fn ordinal(n) {
  if type(n) != "int" { fail("ordinal: expected an int, got " + type(n)); }
  let m = n;
  if m < 0 { m = -m; }
  let suffix = "th";
  if m % 100 < 11 || m % 100 > 13 {
    let last = m % 10;
    if last == 1 { suffix = "st"; }
    if last == 2 { suffix = "nd"; }
    if last == 3 { suffix = "rd"; }
  }
  return str(n) + suffix;
}

# A URL-friendly form of s: lowercased, every run of characters that
# is neither a digit nor a cased letter collapsed to one dash, dashes
# trimmed from both ends ("" when nothing is left). Accented letters
# stay as they are, lowercased.
fn slug(s) {
  let out = "";
  let pending = false;
  for c in lower(s) {
    if is_digit(c) || is_alpha(c) {
      if pending && out != "" { out = out + "-"; }
      pending = false;
      out += c;
    } else {
      pending = true;
    }
  }
  return out;
}

# The longest prefix of s that fits in width COLUMNS. A wide
# character is kept whole, so the answer can be a column short of
# width rather than cut one in half.
fn fit(s, width) {
  let used = 0;
  for i in range(len(s)) {
    let w = display_width(slice(s, i, i + 1));
    if used + w > width { return slice(s, 0, i); }
    used = used + w;
  }
  return s;
}

# s cut to at most width COLUMNS, with suffix marking the cut (the
# suffix counts toward the width). Shorter strings pass through. The
# default suffix is the one the interpreter's own elided traces use,
# so a table and a diagnostic mark a cut the same way.
fn truncate(s, width, suffix = "...") {
  if display_width(s) <= width { return s; }
  if display_width(suffix) >= width { return fit(suffix, width); }
  return fit(s, width - display_width(suffix)) + suffix;
}

# s without a leading prefix, or s unchanged when it does not start
# with it.
fn strip_prefix(s, prefix) {
  if !starts_with(s, prefix) { return s; }
  return slice(s, len(prefix), len(s));
}

# s without a trailing suffix, or s unchanged when it does not end
# with it.
fn strip_suffix(s, suffix) {
  if !ends_with(s, suffix) { return s; }
  return slice(s, 0, len(s) - len(suffix));
}

# prefix prepended to every non-empty line of s (empty lines stay
# empty; a trailing newline is preserved).
fn indent(s, prefix) {
  let out = [];
  for line in split(s, "\n") {
    if line == "" { push(out, line); } else { push(out, prefix + line); }
  }
  return join(out, "\n");
}

# True if float(s) would accept s: an int or float literal, optionally
# signed, with surrounding whitespace allowed ("42", "-1.5", " 7 ",
# "1e3"); false for anything else, including "".
fn is_number(s) {
  return has(try(float, s), "ok");
}

# True if s is empty or only whitespace.
fn is_blank(s) { return trim_start(s) == ""; }

# Rows (lists of strings) padded into aligned columns, two spaces
# apart, one line per row. Ragged rows are fine — widths come from the
# longest cell per column.
#
# align is one character per column — `<` left, `>` right, `^`
# centred, the way a format spec spells them — and a column past its
# end is left-aligned, so the default lines everything up on the left
# as before. A LEFT-ALIGNED CELL IN THE LAST POSITION IS NOT PADDED,
# since nothing follows it and no line should end in spaces; a right
# or centred one is, because that padding is what puts its column
# under the heading.
fn table(rows, align = "") {
  let widths = [];
  for row in rows {
    for i in range(len(row)) {
      if i == len(widths) { push(widths, 0); }
      if display_width(row[i]) > widths[i] { widths[i] = display_width(row[i]); }
    }
  }
  let lines = [];
  for row in rows {
    let cells = [];
    for i in range(len(row)) {
      let how = "<";
      if i < len(align) { how = align[i]; }
      if how == "<" {
        if i == len(row) - 1 { push(cells, row[i]); } else { push(cells, pad_right(row[i], widths[i])); }
      } else if how == ">" {
        push(cells, pad_left(row[i], widths[i]));
      } else if how == "^" {
        push(cells, center(row[i], widths[i]));
      } else {
        fail("table: alignment must be <, > or ^, got " + how);
      }
    }
    push(lines, join(cells, "  "));
  }
  return join(lines, "\n");
}

# Greedy word wrap: words (any whitespace-separated) packed into lines
# of at most width COLUMNS, joined by newlines. A word wider than
# width stands alone on its line; width must be positive.
fn wrap(s, width) {
  if width <= 0 { fail("wrap: width must be positive"); }
  let lines = [];
  let cur = "";
  for w in words(s) {
    if cur == "" {
      cur = w;
    } else if display_width(cur) + 1 + display_width(w) <= width {
      cur += " " + w;
    } else {
      push(lines, cur);
      cur = w;
    }
  }
  if cur != "" { push(lines, cur); }
  return join(lines, "\n");
}

# Edit distance between two strings (insertions, deletions and
# substitutions each cost one; plain Levenshtein — a transposition
# counts two). Character-based, so accented text measures correctly.
fn levenshtein(a, b) {
  let ca = chars(a);
  let cb = chars(b);
  let prev = range(len(cb) + 1);
  for i in range(len(ca)) {
    let cur = [i + 1];
    for j in range(len(cb)) {
      let cost = 1;
      if ca[i] == cb[j] { cost = 0; }
      let best = prev[j] + cost;
      if prev[j + 1] + 1 < best { best = prev[j + 1] + 1; }
      if cur[j] + 1 < best { best = cur[j] + 1; }
      push(cur, best);
    }
    prev = cur;
  }
  return prev[len(cb)];
}

# The common leading whitespace of all non-blank lines removed from
# every line; blank lines become empty. Tabs and spaces count as
# characters, so mixed indentation dedents by the shared prefix only.
fn dedent(s) {
  let lines = split(s, "\n");
  let common = nil;
  for line in lines {
    if is_blank(line) { continue; }
    let n = len(line) - len(trim_start(line));
    if common == nil || n < common { common = n; }
  }
  if common == nil { common = 0; }
  let out = [];
  for line in lines {
    if is_blank(line) { push(out, ""); } else { push(out, slice(line, common, len(line))); }
  }
  return join(out, "\n");
}
