# Map helpers, written in ting. Use them via
#   let m = import("lib/map.ting");

# The two maps in one. Where a key is in both, b's value wins;
# neither input is changed.
fn merge(a, b) {
  let out = {};
  for k in a { out[k] = a[k]; }
  for k in b { out[k] = b[k]; }
  return out;
}

# The first key (in key order) whose value equals v, or nil when no
# value does — the inverse lookup.
fn key_of(m, v) {
  for k in m {
    if m[k] == v { return k; }
  }
  return nil;
}

# merge, except that a key present in both maps gets f(a[k], b[k])
# instead of b's value.
fn merge_with(a, b, f) {
  let out = {};
  for k in a { out[k] = a[k]; }
  for k in b {
    if has(out, k) { out[k] = f(out[k], b[k]); } else { out[k] = b[k]; }
  }
  return out;
}

# The map as [key, value] pairs in sorted key order, matching keys()
# and values(). The builtin of the same name does the work; this line
# is what puts it in the module's map, so
# `import("lib/map.ting")["items"]` still finds it.
let items = items;

# A map built from [key, value] pairs — the inverse of items(). A
# repeated key keeps the last pair's value.
fn from_items(pairs) {
  let out = {};
  for [k, v] in pairs { out[k] = v; }
  return out;
}

# Values in sorted key order (matching keys() and items()), the
# builtin re-exported the way items is.
let values = values;

# A fresh map with f applied to every value.
fn map_values(m, f) {
  let out = {};
  for k in m { out[k] = f(m[k]); }
  return out;
}

# A fresh map with every key passed through f, which must return a
# string; when two keys map to the same name the later one (in key
# order) wins.
fn map_keys(m, f) {
  let out = {};
  for k in m {
    let nk = f(k);
    if type(nk) != "string" { fail("map_keys: f must return a string, got " + type(nk)); }
    out[nk] = m[k];
  }
  return out;
}

# A fresh map with only the listed keys (missing keys are skipped).
fn pick(m, ks) {
  let out = {};
  for k in ks {
    if has(m, k) { out[k] = m[k]; }
  }
  return out;
}

# A fresh map without the listed keys.
#
# Copy, then take those keys out: asking `contains(ks, k)` about every
# key of m instead costs one pass of ks per key of m, which at 1000
# keys removed from 4000 measured 22 ms against this shape's 4.
fn omit(m, ks) {
  let out = {};
  for k in m { out[k] = m[k]; }
  for k in ks {
    if has(out, k) { pop(out, k); }
  }
  return out;
}

# A fresh map with only the entries for which pred(key, value) holds.
fn filter_map(m, pred) {
  let out = {};
  for k in m {
    if pred(k, m[k]) { out[k] = m[k]; }
  }
  return out;
}

# True if every listed key is present (true for an empty list).
fn has_all(m, ks) {
  for k in ks {
    if !has(m, k) { return false; }
  }
  return true;
}

# A fresh map with keys and values swapped; every value must be a
# string, and among duplicate values the last key (in key order) wins.
fn invert(m) {
  let out = {};
  for k in m {
    let v = m[k];
    if type(v) != "string" { fail("invert: values must be strings, got " + type(v)); }
    out[v] = k;
  }
  return out;
}

# A fresh map with k set to v (the input is untouched).
fn with(m, k, v) {
  let out = merge(m, {});
  out[k] = v;
  return out;
}

# A fresh map with f applied to the value at k; the key must exist.
fn update(m, k, f) {
  if !has(m, k) { fail("update: missing key " + k); }
  return with(m, k, f(m[k]));
}

# The n entries with the largest values as [key, value] pairs, largest
# first; ties keep key order. Values must be numbers. The most
# frequent entries of a frequency count come out this way: count_by
# or frequencies, then top.
fn top(m, n) {
  if n < 0 { fail("top: negative count"); }
  let ranked = sort_by(items(m), fn([_, v]) { return 0 - v; });
  if n > len(ranked) { n = len(ranked); }
  return slice(ranked, 0, n);
}
