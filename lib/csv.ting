# Delimited text, both directions, written in ting.
# Use it via
#   let csv = import("lib/csv.ting");
#
# The dialect is the usual one: fields separated by a comma, a field
# wrapped in double quotes when it holds a comma, a quote, or a line
# break, and a quote inside such a field written twice. CRLF is read
# as a line break and written as a bare newline, since a script that
# reads Windows output should not have to say so.
#
# An empty line is a row with one empty field, which is what a reader
# that counts columns expects. Text ending in a line break does not
# make a final empty row.

# A field, quoted if it needs to be. Leading or trailing spaces are
# quoted too: they survive a round trip that way, and a reader that
# trims them can still do so.
fn quote(field, sep) {
  let needs = contains(field, sep) || contains(field, "\"")
  || contains(field, "\n") || contains(field, "\r")
  || starts_with(field, " ") || ends_with(field, " ");
  if !needs { return field; }
  return "\"" + replace(field, "\"", "\"\"") + "\"";
}

# The state a scan carries between chunks: the rows it has finished,
# the row and field it is part way through, and whether a quoted
# field is open. Feeding a whole file to the scanner and feeding it a
# line at a time give exactly the same rows, which is what lets
# each_row be right rather than nearly right.
fn fresh() {
  return {"rows": [], "row": [], "field": "", "quoted": false, "pending": false,
    "started": false, "dirty": false};
}

# One chunk of text through the scanner. The loop runs on locals
# rather than on the map — reading a field character by character is
# the hot path, and a map lookup per character costs more than the
# two loads and stores around it.
fn scan(st, text, sep) {
  let rows = st["rows"];
  let row = st["row"];
  let field = st["field"];
  let quoted = st["quoted"];
  # A quote seen inside a quoted field: the next character says
  # whether it was an escaped quote or the end of the field.
  let pending = st["pending"];
  let started = st["started"];
  let dirty = st["dirty"];
  for c in text {
    if pending {
      pending = false;
      if c == "\"" { field = field + "\""; continue; }
      quoted = false;
    }
    if quoted {
      if c == "\"" { pending = true; continue; }
      field += c;
      continue;
    }
    if c == "\"" && field == "" && !started {
      quoted = true;
      started = true;
      dirty = true;
      continue;
    }
    if c == sep {
      push(row, field);
      field = "";
      started = false;
      dirty = true;
      continue;
    }
    if c == "\r" { continue; }
    if c == "\n" {
      push(row, field);
      push(rows, row);
      row = [];
      field = "";
      started = false;
      dirty = false;
      continue;
    }
    field += c;
    dirty = true;
  }
  st["row"] = row;
  st["field"] = field;
  st["quoted"] = quoted;
  st["pending"] = pending;
  st["started"] = started;
  st["dirty"] = dirty;
  return st;
}

# The end of the text: whatever the scanner is still holding becomes
# a last row, unless it is holding nothing.
fn finish(st) {
  if st["dirty"] || len(st["row"]) > 0 {
    push(st["row"], st["field"]);
    push(st["rows"], st["row"]);
    st["row"] = [];
    st["field"] = "";
    st["dirty"] = false;
  }
  return st;
}

# Rows of fields from delimited text. The separator is a comma unless
# another single character is given.
fn parse(text, sep = ",") {
  return finish(scan(fresh(), text, sep))["rows"];
}

# Rows from a file, one at a time, without holding the file: f(row)
# for each, and only the row in hand is kept. A row is not a line —
# a quoted field may contain line breaks — so this feeds the same
# scanner parse uses and hands over a row when the scanner finishes
# one, rather than cutting on newlines. Counting lines invents rows:
# a 15.7 MB export of 300000 rows measured here has 400001 lines.
# "-" is stdin, and f returning false stops the read, both as
# each_line does. Answers how many rows f was given.
fn each_row(path, f, sep = ",") {
  let st = fresh();
  let n = 0;
  let stopped = false;
  each_line(path, fn(line) {
    scan(st, line + "\n", sep);
    let done = st["rows"];
    if len(done) == 0 { return nil; }
    st["rows"] = [];
    for row in done {
      n += 1;
      if f(row) == false {
        stopped = true;
        return false;
      }
    }
    return nil;
  });
  # A file that ends inside an open quoted field leaves the scanner
  # holding a row, and parse would hand that back too: the two must
  # agree on every input, including the malformed ones.
  if !stopped {
    finish(st);
    for row in st["rows"] {
      n += 1;
      f(row);
    }
  }
  return n;
}

# The older spelling of `parse` with an explicit separator, kept for
# the programs that use it.
fn parse_with(text, sep) { return parse(text, sep); }

# Delimited text from rows of fields; the separator is a comma unless
# another single character is given. The text ends in a line break, as
# a text file's last line does.
fn text(rows, sep = ",") {
  let lines = [];
  for row in rows {
    let fields = [];
    for field in row { push(fields, quote(str(field), sep)); }
    push(lines, join(fields, sep));
  }
  if len(lines) == 0 { return ""; }
  return join(lines, "\n") + "\n";
}

# The older spelling of `text` with an explicit separator.
fn text_with(rows, sep) { return text(rows, sep); }

# The first row read as a header, the rest as maps from column name to
# field. A row shorter than the header leaves those columns nil; extra
# fields have no name and are dropped.
fn maps(rows) {
  if len(rows) == 0 { return []; }
  let header = rows[0];
  let out = [];
  for i in range(1, len(rows)) {
    let row = rows[i];
    let entry = {};
    for c in range(0, len(header)) {
      if c < len(row) { entry[header[c]] = row[c]; }
      else { entry[header[c]] = nil; }
    }
    push(out, entry);
  }
  return out;
}
